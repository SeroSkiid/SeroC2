<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Colors & Brushes ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SidebarCtrlBgBrush" Color="#1A1C2E" />

    <!-- Text / Foreground -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#DDE0F0" />
    <SolidColorBrush x:Key="TextHighlightBrush" Color="#89dceb" />

    <!-- Accents -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4A85F5" Offset="0"/>
        <GradientStop Color="#7C5CE8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Status -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#22C55E" />

    <!-- Shared Styles -->
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextHighlightBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StandardTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
