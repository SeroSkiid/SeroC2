<dx:ThemedWindow x:Class="SeroServer.UI.MinerStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Miner Stats"
        Width="1000" Height="580" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <dx:ThemedWindow.Resources>
        <Style x:Key="ColHdr" TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{DynamicResource LabelBrush}"/>
            <Setter Property="FontSize"     Value="9"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="10,6"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource SectionBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="Cell" TargetType="DataGridCell">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"  Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Row" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </dx:ThemedWindow.Resources>

    <Grid Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="{DynamicResource SectionBgBrush}"
                BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: icon + status indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⛏" FontFamily="Segoe UI Symbol" Foreground="#F59E0B" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="#6B7280"/>
                    <TextBlock x:Name="LblStatus" Text="Stopped" Foreground="{DynamicResource LabelBrush}"
                               FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblEndpoint" Text="" Foreground="{DynamicResource LabelBrush}"
                               FontSize="9" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- Right: port + start/stop + refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Port field (only visible when stopped) -->
                    <StackPanel x:Name="PortPanel" Orientation="Horizontal" Margin="0,0,8,0">
                        <TextBlock Text="Port:" Foreground="{DynamicResource LabelBrush}" FontSize="10"
                                   FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtStatsPort" Text="8081" Width="52" Height="26"
                                 FontFamily="Consolas" FontSize="11"
                                 Background="{DynamicResource InputBgBrush}"
                                 Foreground="{DynamicResource ContentTextBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                 VerticalContentAlignment="Center" Padding="4,0"/>
                    </StackPanel>
                    <Button x:Name="BtnStart" Content="START" Height="26" Padding="12,0" Margin="0,0,6,0"
                            Style="{StaticResource SGreenBtn}" FontSize="10" Click="BtnStart_Click"/>
                    <Button x:Name="BtnStop" Content="STOP" Height="26" Padding="12,0" Margin="0,0,6,0"
                            Style="{StaticResource SRedBtn}" FontSize="10" Click="BtnStop_Click"
                            Visibility="Collapsed"/>
                    <Button x:Name="BtnRefresh" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                            Width="28" Height="28" Padding="0" Click="BtnRefresh_Click"
                            Style="{StaticResource SBtn}" ToolTip="Refresh"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary pills -->
        <Border Grid.Row="1" Padding="14,10" Background="{DynamicResource SectionBgBrush}"
                BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,8,0"
                        BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                   Foreground="#22C55E" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PillOnline" Text="0" Foreground="#22C55E"
                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PillOnlineLbl" Text=" online" Foreground="{DynamicResource LabelBrush}"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,8,0"
                        BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⛏" FontFamily="Segoe UI Symbol" Foreground="#F59E0B" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PillHashrate" Text="0.0 H/s" Foreground="#F59E0B"
                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text=" total" Foreground="{DynamicResource LabelBrush}"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="4" Padding="12,6"
                        BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                   Foreground="#60A0FF" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PillAccepted" Text="0" Foreground="#60A0FF"
                                   FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PillAcceptedLbl" Text=" accepted" Foreground="{DynamicResource LabelBrush}"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Table -->
        <DataGrid Grid.Row="2" x:Name="MinerGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource SectionBorderBrush}"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  BorderThickness="0"
                  HeadersVisibility="Column"
                  ColumnHeaderStyle="{StaticResource ColHdr}"
                  CellStyle="{StaticResource Cell}"
                  RowStyle="{StaticResource Row}"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STATUS"  Binding="{Binding StatusText}"  Width="70"/>
                <DataGridTextColumn Header="HOST"    Binding="{Binding Hostname}"    Width="140"/>
                <DataGridTextColumn Header="IP"      Binding="{Binding Ip}"          Width="120"/>
                <DataGridTextColumn Header="CPU"     Binding="{Binding CpuShort}"    Width="160"/>
                <DataGridTextColumn Header="H/S"     Binding="{Binding H1sStr}"      Width="80"/>
                <DataGridTextColumn Header="ALGO"    Binding="{Binding Algo}"        Width="90"/>
                <DataGridTextColumn Header="POOL"    Binding="{Binding PoolShort}"   Width="180"/>
                <DataGridTextColumn Header="SHARES"  Binding="{Binding Accepted}"    Width="70"/>
                <DataGridTextColumn Header="UPTIME"  Binding="{Binding UptimeStr}"   Width="80"/>
                <DataGridTextColumn Header="LAST SEEN" Binding="{Binding LastSeenStr}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource SectionBgBrush}"
                BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="FooterStatus" Text="" Foreground="{DynamicResource LabelBrush}" FontSize="9"/>
        </Border>
    </Grid>
</dx:ThemedWindow>
