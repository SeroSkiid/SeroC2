<dx:ThemedWindow x:Class="SeroServer.UI.ServiceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:local="clr-namespace:SeroServer.UI"
        Title="Service Manager"
        Width="1040" Height="600" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">
    <dx:ThemedWindow.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </dx:ThemedWindow.Resources>
    <DockPanel LastChildFill="True">

        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="pack://application:,,,/Resources/Icons/services.svg" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCount" FontSize="11" Foreground="{DynamicResource FieldLabelBrush}" FontFamily="Consolas" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar: search + action buttons -->
        <Border DockPanel.Dock="Top" Height="38" Background="{DynamicResource TitleBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Search box -->
                <Border Grid.Column="0" CornerRadius="4" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1" VerticalAlignment="Center" Height="26" MaxWidth="320" HorizontalAlignment="Left">
                    <Grid>
                        <TextBlock x:Name="TxtSvcSearchHint" Text="Search services…" Foreground="{DynamicResource FieldLabelBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ContentTextBrush}" FontSize="11" FontFamily="Segoe UI Variable Text, Segoe UI"
                                 VerticalAlignment="Center" Padding="8,0" CaretBrush="{DynamicResource AccentBrush}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Background="Transparent"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
                <!-- Refresh only — actions via right-click -->
                <Button Grid.Column="1" Height="26" Padding="10,0"
                        Style="{StaticResource SBtn}" FontSize="11" Click="BtnRefresh_Click"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Audit_ChangeHistory.svg'}" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtBtnRefreshSvc" Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource FieldLabelBrush}" FontSize="11"
                           FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0"/>
                <TextBlock x:Name="TxtCountdown" Text="" Foreground="{DynamicResource FieldLabelBrush}" FontSize="11"
                           FontFamily="Consolas" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,12,0"/>
            </Grid>
        </Border>

        <!-- Services grid -->
        <DataGrid x:Name="GridServices" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource ContentTextBrush}" BorderThickness="0"
                  RowBackground="Transparent" AlternatingRowBackground="{DynamicResource AlternatingRowBgBrush}"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource SectionBorderBrush}" VerticalGridLinesBrush="{DynamicResource SectionBorderBrush}"
                  HeadersVisibility="Column" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  EnableColumnVirtualization="True"
                  ScrollViewer.CanContentScroll="True"
                  EnableRowVirtualization="True"
                  ContextMenuOpening="GridServices_ContextMenuOpening"
                  ColumnHeaderStyle="{StaticResource SColHeader}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border x:Name="CellBd" Background="Transparent" Padding="10,4" BorderThickness="0">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowHoverBgBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowSelBgBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MnuSvcStart"   Header="Start"   Click="BtnStart_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Validation.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MnuSvcStop"    Header="Stop"    Click="BtnStop_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Remove.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MnuSvcRestart" Header="Restart" Click="BtnRestart_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Audit_ChangeHistory.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MnuSvcDisable" Header="Disable" Click="BtnDisable_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Organization.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MnuSvcDelete"  Header="Delete"  Click="BtnDelete_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Trash.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MnuSvcCopyName" Header="Copy Name" Click="GridServices_CopyName_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Document.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MnuSvcRefresh" Header="Refresh" Click="BtnRefresh_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Refresh.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <!-- Name with glyph colored by status + DisplayName -->
                <DataGridTemplateColumn x:Name="ColSvcName" Header="NAME" Width="220" SortMemberPath="DisplayName" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <Image Source="{x:Static local:ServiceEntryVM.SvcIcon}" Width="14" Height="14"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ContentTextBrush}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Description -->
                <DataGridTextColumn x:Name="ColSvcDesc" Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>

                <!-- Status: colored dot + text -->
                <DataGridTemplateColumn x:Name="ColSvcStatus" Header="STATUS" Width="100" SortMemberPath="Status" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding StatusDot}" Foreground="{Binding StatusColor}"
                                           FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Startup Type: colored text -->
                <DataGridTemplateColumn x:Name="ColSvcStartType" Header="STARTUP TYPE" Width="110" SortMemberPath="StartType" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StartType}" Foreground="{Binding StartTypeColor}"
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Log On As -->
                <DataGridTextColumn x:Name="ColSvcLogOn" Header="LOG ON AS" Binding="{Binding LogOnAs}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</dx:ThemedWindow>
