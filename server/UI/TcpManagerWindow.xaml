<dx:ThemedWindow x:Class="SeroServer.UI.TcpManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:local="clr-namespace:SeroServer.UI"
        Title="TCP Connections"
        Width="920" Height="540" MinWidth="680" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

    <dx:ThemedWindow.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="ESTABLISHED">
                    <Setter Property="Foreground" Value="#4ADE80"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="LISTEN">
                    <Setter Property="Foreground" Value="#60A5FA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="TIME_WAIT">
                    <Setter Property="Foreground" Value="#FBBF24"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="CLOSE_WAIT">
                    <Setter Property="Foreground" Value="#F87171"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="SYN_SENT">
                    <Setter Property="Foreground" Value="#FBBF24"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="SYN_RCVD">
                    <Setter Property="Foreground" Value="#FBBF24"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="FIN_WAIT1">
                    <Setter Property="Foreground" Value="#F87171"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="FIN_WAIT2">
                    <Setter Property="Foreground" Value="#F87171"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </dx:ThemedWindow.Resources>

    <DockPanel LastChildFill="True">

        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Router.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCount" FontSize="11" Foreground="{DynamicResource FieldLabelBrush}" FontFamily="Consolas" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Height="27" Width="30" Margin="0,0,4,0"
                            Style="{StaticResource SBtn}" Padding="0" Click="Refresh_Click" ToolTip="Refresh">
                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Audit_ChangeHistory.svg'}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar + State legend bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarCtrlBgBrush}" BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Action buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SBtn}" Height="24" FontSize="11" Padding="8,0" Margin="0,0,4,0" Click="BlockIp_Click" ToolTip="Block remote IP in Windows Firewall (inbound + outbound)">
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Validation.svg'}" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnBlockIp" Text="Block IP" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SBtn}" Height="24" FontSize="11" Padding="8,0" Click="BlockPort_Click" ToolTip="Block TCP port in Windows Firewall (inbound + outbound)">
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Validation.svg'}" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnBlockPort" Text="Block Port" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- State legend -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="ESTABLISHED" Foreground="{DynamicResource ContentTextBrush}" FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="LISTEN" Foreground="{DynamicResource ContentTextBrush}" FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="WAIT" Foreground="{DynamicResource ContentTextBrush}" FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="7" Height="7" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="CLOSING" Foreground="{DynamicResource ContentTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource FieldLabelBrush}"
                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0"/>
        </Border>

        <!-- TCP Table -->
        <DataGrid x:Name="GridTcp"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource ContentTextBrush}"
                  BorderThickness="0" RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource SectionBorderBrush}" VerticalGridLinesBrush="{DynamicResource SectionBorderBrush}"
                  HeadersVisibility="Column"
                  FontFamily="Consolas" FontSize="12" SelectionMode="Extended" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserResizeRows="False"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ContextMenuOpening="GridTcp_ContextMenuOpening"
                  ColumnHeaderStyle="{StaticResource SColHeader}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MnuTcpClose"       Header="Close Connection"    Click="CloseConn_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Remove.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MnuTcpKill"        Header="Kill Process"        Click="KillProc_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Skull.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MnuTcpCopyLocal"   Header="Copy Local Address"  Click="GridTcp_CopyLocal_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Document.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MnuTcpCopyRemote"  Header="Copy Remote Address" Click="GridTcp_CopyRemote_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Organization.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="30" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{x:Static local:TcpEntryVM.ExeIcon}" Width="16" Height="16" Margin="6,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColTcpPid"     Header="PID"     Binding="{Binding Pid}"         Width="60"  FontSize="12"/>
                <DataGridTextColumn x:Name="ColTcpProcess" Header="PROCESS" Binding="{Binding ProcessName}" Width="140" FontSize="12"/>
                <DataGridTextColumn x:Name="ColTcpLocal"   Header="LOCAL"   Binding="{Binding LocalAddr}"   Width="*"/>
                <DataGridTextColumn x:Name="ColTcpRemote"  Header="REMOTE"  Binding="{Binding RemoteAddr}"  Width="*"/>
                <DataGridTemplateColumn x:Name="ColTcpState" Header="STATE" Width="120" SortMemberPath="State">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="10,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#3A4060"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="ESTABLISHED"><Setter Property="Fill" Value="#22C55E"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="LISTEN">     <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="TIME_WAIT">  <Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="CLOSE_WAIT"> <Setter Property="Fill" Value="#EF4444"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="SYN_SENT">   <Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="SYN_RCVD">   <Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="FIN_WAIT1">  <Setter Property="Fill" Value="#EF4444"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="FIN_WAIT2">  <Setter Property="Fill" Value="#EF4444"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding State}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</dx:ThemedWindow>
