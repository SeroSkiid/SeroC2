<dx:ThemedWindow x:Class="SeroServer.UI.SpeakToClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Speak to Client"
        Width="400" Height="210" MinWidth="340" MinHeight="185"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowGlow="False">

    <DockPanel LastChildFill="True">
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Volume.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource TitleLabelBrush}"
                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0"/>
        </Border>

        <!-- Content -->
        <Border Background="{DynamicResource SidebarCtrlBgBrush}" Padding="18,14">
            <StackPanel>
                <!-- Mic device -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtLblDevice" Grid.Column="0" Text="Input device:"
                               Foreground="{DynamicResource TitleLabelBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbMicDevice" Height="28"
                              Style="{StaticResource SCombo}" FontSize="11"/>
                </Grid>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSpeakStart" Height="28" Padding="16,0" Margin="0,0,8,0"
                            Style="{StaticResource SGreenBtn}" FontSize="11" Click="SpeakStart_Click"/>
                    <Button x:Name="BtnSpeakStop"  Height="28" Padding="16,0"
                            Style="{StaticResource SRedBtn}" FontSize="11" Click="SpeakStop_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</dx:ThemedWindow>
