<dx:ThemedWindow x:Class="SeroServer.UI.FileSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="File Search"
        Width="700" Height="500" MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

    <dx:ThemedWindow.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </dx:ThemedWindow.Resources>

    <DockPanel LastChildFill="True">
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Find.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource TitleLabelBrush}"
                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0"/>
        </Border>

        <!-- Search controls -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Path + Pattern -->
                <TextBlock x:Name="TxtLblPath" Grid.Row="0" Grid.Column="0" Text="Root Path:"
                           Foreground="{DynamicResource TitleLabelBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtPath" Height="26"
                           Style="{StaticResource STxt}" FontSize="11" Text="C:\"
                           FontFamily="Consolas"/>

                <TextBlock x:Name="TxtLblPattern" Grid.Row="0" Grid.Column="3" Text="Pattern:"
                           Foreground="{DynamicResource TitleLabelBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="0" Grid.Column="4" x:Name="TxtPattern" Height="26"
                           Style="{StaticResource STxt}" FontSize="11" Text="*"
                           FontFamily="Consolas"/>

                <!-- Row 2: Recursive + Search button -->
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="ChkRecursive" IsChecked="True" Margin="0,0,16,0"
                              Foreground="{DynamicResource ContentTextBrush}" FontSize="11">
                        <TextBlock x:Name="TxtRecursive" Text="Recursive"/>
                    </CheckBox>
                </StackPanel>
                <Button Grid.Row="2" Grid.Column="4" x:Name="BtnSearch"
                        Height="26" Padding="14,0" HorizontalAlignment="Right"
                        Style="{StaticResource SGreenBtn}" FontSize="11" Click="Search_Click">
                    <StackPanel Orientation="Horizontal">
                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Find.svg'}" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtBtnSearch" Text="Search"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Results grid -->
        <Border Background="{DynamicResource SectionBgBrush}">
            <DataGrid x:Name="GridResults"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="True"
                      SelectionMode="Extended"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="{DynamicResource AlternateRowBrush}"
                      Background="{DynamicResource SectionBgBrush}"
                      Foreground="{DynamicResource ContentTextBrush}"
                      RowBackground="Transparent"
                      BorderThickness="0"
                      FontSize="11"
                      FontFamily="Consolas"
                      ColumnHeaderStyle="{StaticResource SColHeader}">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColName"     Header="Name"     Binding="{Binding Name}"     Width="*"/>
                    <DataGridTextColumn x:Name="ColFullPath" Header="Full Path" Binding="{Binding FullPath}" Width="2*"/>
                    <DataGridTextColumn x:Name="ColSize"     Header="Size"      Binding="{Binding SizeText}" Width="80"/>
                    <DataGridTextColumn x:Name="ColType"     Header="Type"      Binding="{Binding TypeText}" Width="60"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MnuCopyPath" Header="Copy Path" Click="CopyPath_Click">
                            <MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Edit/Copy.svg'}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MnuOpenInFm" Header="Open in File Manager" Click="OpenInFm_Click">
                            <MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Folder.svg'}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
    </DockPanel>
</dx:ThemedWindow>
