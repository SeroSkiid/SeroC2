<dx:ThemedWindow x:Class="SeroServer.UI.PerformanceMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Performance Monitor"
        Width="720" Height="600" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

    <DockPanel>
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Business_LinearChart.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnMenu" Height="26" Padding="8,0" Margin="0,0,4,0"
                            Style="{StaticResource SBtn}" FontSize="11" ToolTip="Actions" Click="BtnMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Ellipsis.svg'}" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Actions" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Connecting…" Foreground="{DynamicResource FieldLabelBrush}"
                           FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0"/>
            </Grid>
        </Border>

        <!-- Performance panels -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,14" >

                <!-- CPU -->
                <Border Background="{DynamicResource SidebarCtrlBgBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}"/>
                            <TextBlock x:Name="TxtCpu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" FontFamily="Consolas"/>
                        </Grid>
                        <Border Height="18" Background="{DynamicResource InputBgBrush}" CornerRadius="3">
                            <Border x:Name="BarCpu" HorizontalAlignment="Left" Width="0" Height="18"
                                    CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1A4A9A" Offset="0"/>
                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <!-- Sparkline canvas -->
                        <Canvas x:Name="SparkCpu" Height="40" Margin="0,8,0,0" ClipToBounds="True"
                                Background="{DynamicResource ChartBgBrush}"/>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Background="{DynamicResource SidebarCtrlBgBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}"/>
                            <TextBlock x:Name="TxtRam" FontSize="20" FontWeight="Bold" Foreground="#7C5CE8"
                                       HorizontalAlignment="Right" FontFamily="Consolas"/>
                        </Grid>
                        <Border Height="18" Background="{DynamicResource InputBgBrush}" CornerRadius="3">
                            <Border x:Name="BarRam" HorizontalAlignment="Left" Width="0" Height="18"
                                    CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3A1A7A" Offset="0"/>
                                        <GradientStop Color="#7C5CE8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <Canvas x:Name="SparkRam" Height="40" Margin="0,8,0,0" ClipToBounds="True"
                                Background="{DynamicResource ChartBgBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Background="{DynamicResource SidebarCtrlBgBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,0"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="NETWORK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="↑ " Foreground="#22C55E" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"/>
                                <TextBlock x:Name="TxtNetSent" FontSize="12" FontWeight="Bold" Foreground="#22C55E" FontFamily="Consolas" Margin="0,0,14,0"/>
                                <TextBlock Text="↓ " Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"/>
                                <TextBlock x:Name="TxtNetRecv" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                        <Canvas x:Name="SparkNet" Height="50" ClipToBounds="True"
                                Background="{DynamicResource ChartBgBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</dx:ThemedWindow>
