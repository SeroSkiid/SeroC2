<dx:ThemedWindow x:Class="SeroServer.UI.GeoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Geolocation"
        Width="500" Height="560" MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

    <DockPanel LastChildFill="True">
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Travel_MapPointer.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                    <Button x:Name="BtnLocate" Height="26" Padding="12,0" Margin="0,0,4,0"
                            Style="{StaticResource SGreenBtn}" FontSize="11" Click="Locate_Click">
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Travel_MapPointer.svg'}" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnLocate" Text="Locate"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnOpenMap" Height="26" Padding="10,0"
                            Style="{StaticResource SBtn}" FontSize="11" Click="OpenMap_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Open.svg'}" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnMap" Text="Open in Maps"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource TitleLabelBrush}"
                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0"/>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Map area -->
                <RowDefinition Height="220"/>
                <!-- Divider -->
                <RowDefinition Height="1"/>
                <!-- Data section -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Map area ── -->
            <Grid Grid.Row="0" Background="{DynamicResource SidebarCtrlBgBrush}">
                <!-- Idle placeholder -->
                <StackPanel x:Name="PnlMapIdle" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Travel_MapPointer.svg'}" Width="56" Height="56" HorizontalAlignment="Center" Opacity="0.15"/>
                    <TextBlock x:Name="TxtIdle" Text="Press Locate to get geolocation data."
                               Foreground="{DynamicResource LabelBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                </StackPanel>

                <!-- Error placeholder (shown when geo fails) -->
                <StackPanel x:Name="PnlMapError" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Cancel.svg'}" Width="40" Height="40" HorizontalAlignment="Center" Opacity="0.35"/>
                    <TextBlock x:Name="TxtMapError" Text=""
                               Foreground="{DynamicResource LabelBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                </StackPanel>

                <!-- Embedded map (WebBrowser navigated to Google Maps embed) -->
                <WebBrowser x:Name="MapBrowser" Visibility="Collapsed"/>
            </Grid>

            <!-- Divider -->
            <Border Grid.Row="1" Background="{DynamicResource InputBorderBrush}"/>

            <!-- ── Data section ── -->
            <ScrollViewer Grid.Row="2" Background="{DynamicResource SectionBgBrush}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlData" Margin="18,14,18,14" Visibility="Collapsed">

                    <!-- Address card (city / region / country + ISP) -->
                    <Border Background="{DynamicResource TitleBgBrush}" CornerRadius="4"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                            Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAddress"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ContentTextBrush}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtIspLine"
                                           FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource LabelBrush}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnCopyAddr"
                                    Height="26" Padding="10,0" Margin="10,0,0,0"
                                    Style="{StaticResource SBtn}" FontSize="11"
                                    Click="CopyAddr_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Edit/Copy.svg'}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBtnCopyAddr" Text="Copy"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Coordinates row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLblCoords" Grid.Column="0"
                                   Text="Coordinates:" Foreground="{DynamicResource TitleLabelBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtCoords" Grid.Column="1"
                                   Text="" Foreground="{DynamicResource ContentTextBrush}"
                                   FontSize="12" FontFamily="Consolas"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" x:Name="BtnCopyCoords"
                                Height="24" Padding="8,0" Margin="8,0,0,0"
                                Style="{StaticResource SBtn}" FontSize="11"
                                Click="CopyCoords_Click" IsEnabled="False" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBtnCopy" Text="Copy"/>
                        </Button>
                    </Grid>

                    <!-- Source row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtLblSource" Grid.Column="0"
                                   Text="Source:" Foreground="{DynamicResource TitleLabelBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtSource" Grid.Column="1"
                                   Text="" Foreground="{DynamicResource LabelBrush}"
                                   FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Raw JSON (collapsed by default) -->
                    <Expander x:Name="ExpanderRaw" Header="Raw JSON" Margin="0,4,0,0"
                              Foreground="{DynamicResource TitleLabelBrush}" FontSize="11">
                        <TextBox x:Name="TxtRaw" Text=""
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource FieldLabelBrush}"
                                 FontSize="10" FontFamily="Consolas"
                                 Margin="0,6,0,0"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</dx:ThemedWindow>
