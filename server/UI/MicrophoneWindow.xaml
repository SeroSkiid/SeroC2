<dx:ThemedWindow x:Class="SeroServer.UI.MicrophoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Microphone"
        Width="480" Height="380" MinWidth="400" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

    <DockPanel LastChildFill="True">
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Microphone.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnMenu" Height="26" Padding="8,0" Margin="0,0,4,0"
                            Style="{StaticResource SBtn}" FontSize="11" ToolTip="Actions" Click="BtnMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Ellipsis.svg'}" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnActions" Text="Actions" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
<TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource LabelBrush}"
                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0"/>
            </Grid>
        </Border>

        <!-- Controls -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel>
                <!-- Row 1: device selector -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Device:" Foreground="{DynamicResource LabelBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbDevice" Height="28"
                              Style="{StaticResource SCombo}" FontSize="11"/>
                </Grid>
                <!-- Row 2: action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRecord" Content="Start" Height="28" Padding="14,0"
                            Margin="0,0,6,0" Style="{StaticResource SGreenBtn}" FontSize="11" Click="Record_Click"/>
                    <Button x:Name="BtnStop" Content="Stop" Height="28" Padding="14,0"
                            Margin="0,0,6,0" Style="{StaticResource SRedBtn}" FontSize="11"
                            Click="Stop_Click" IsEnabled="False"/>
                    <Button Content="Save WAV" Height="28" Padding="12,0"
                            Style="{StaticResource SBtn}" FontSize="11" Click="SaveWav_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Waveform canvas -->
        <Border Background="{DynamicResource SidebarCtrlBgBrush}" Margin="0">
            <Grid>
                <!-- Recording indicator -->
                <Border x:Name="RecordingIndicator" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="14,10" CornerRadius="10" Padding="8,3" Visibility="Collapsed">
                    <Border.Background>
                        <SolidColorBrush Color="#3A1018"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecDot" Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#EF4444"/></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="TxtRecTime" Text="0:00" Foreground="#f38ba8"
                                   FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Waveform -->
                <Canvas x:Name="WaveCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <!-- Idle placeholder -->
                <StackPanel x:Name="PnlIdle" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_KPI.svg'}" Width="40" Height="40" HorizontalAlignment="Center" Opacity="0.2"/>
                    <TextBlock Text="Select device and press REC"
                               Foreground="{DynamicResource LabelBrush}" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,8,0,0" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</dx:ThemedWindow>
