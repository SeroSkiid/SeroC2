<dx:ThemedWindow x:Class="SeroServer.UI.DeviceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:local="clr-namespace:SeroServer.UI"
        Title="Device Manager" Width="860" Height="520" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowGlow="False">
    <dx:ThemedWindow.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="Padding"               Value="0"/>
            <Setter Property="FocusVisualStyle"      Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellBd" Background="Transparent" Padding="10,4" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowHoverBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowSelBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </dx:ThemedWindow.Resources>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}" BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Mouse.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitle" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCount" FontSize="11" Foreground="{DynamicResource TitleLabelBrush}" FontFamily="Consolas" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnRefresh" Content="&#x27F3;" Height="27" Width="30" Margin="0,0,4,0" Style="{StaticResource SBtn}" FontSize="14" Padding="0" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource FieldLabelBrush}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0"/>
                </Grid>
            </Border>
            <DataGrid x:Name="GridDevs" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource ContentTextBrush}" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="Transparent"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource InputBorderBrush}"
                      HeadersVisibility="Column" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                      SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      ContextMenuOpening="GridDevs_ContextMenuOpening"
                      ColumnHeaderStyle="{StaticResource SColHeader}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MnuDevUninstall" Header="Uninstall"    Click="BtnUninstall_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Trash.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem x:Name="MnuDevCopyName"  Header="Copy Name"    Click="GridDevs_CopyName_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Document.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        <MenuItem x:Name="MnuDevCopyId"    Header="Copy Device ID" Click="GridDevs_CopyId_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Price.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem x:Name="MnuDevRefresh"   Header="Refresh"      Click="BtnRefresh_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Audit_ChangeHistory.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <dx:DXImage Width="16" Height="16"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <dx:DXImage.Style>
                                        <Style TargetType="dx:DXImage">
                                            <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Mouse.svg'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Class}" Value="Display">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Monitor.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Net">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Router.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="NetClient">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Router.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="NetService">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Router.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="DiskDrive">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_HardDrive.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="HDC">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_HardDrive.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="USB">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Usb.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Processor">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Cpu.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Keyboard">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Keyboard.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Media">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Speaker.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="AudioEndpoint">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Speaker.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Bluetooth">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Bluetooth.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Camera">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Camera.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Image">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Camera.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Printer">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Printer.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="PrintQueue">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Printer.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Mouse">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Mouse.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="HIDClass">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Mouse.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Monitor">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Monitor.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="CDROM">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_TV.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Volume">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_HardDrive.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="VolumeSnapshot">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_HardDrive.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="SCSIAdapter">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_HardDrive.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="FDC">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_HardDrive.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="USBDevice">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Usb.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="USBHUB">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Usb.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="WPD">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Usb.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="BTH">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Bluetooth.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="BTHLE">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Bluetooth.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="AudioProcessingObject">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Speaker.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="WDMAudio">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Speaker.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Net">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Router.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="NetTrans">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Router.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Modem">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Router.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="System">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Settings.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Computer">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Settings.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Firmware">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Cpu.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="Ports">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Usb.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="SoftwareComponent">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Settings.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="SoftwareDevice">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Settings.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="SecurityDevices">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Security.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="BTHPAN">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Bluetooth.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="BTHPRINT">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Bluetooth.svg'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Class}" Value="SmartCardReader">
                                                    <Setter Property="Source" Value="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Security.svg'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dx:DXImage.Style>
                                </dx:DXImage>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColDevName"  Header="NAME"         Binding="{Binding Name}"         Width="*"/>
                    <DataGridTextColumn x:Name="ColDevClass" Header="CLASS"        Binding="{Binding Class}"         Width="120"/>
                    <DataGridTextColumn x:Name="ColDevStatus" Header="STATUS"       Binding="{Binding Status}"        Width="80"/>
                    <DataGridTextColumn x:Name="ColDevManuf" Header="MANUFACTURER" Binding="{Binding Manufacturer}"  Width="160"/>
                    <DataGridTextColumn x:Name="ColDevId"    Header="DEVICE ID"    Binding="{Binding DeviceId}"      Width="200" FontFamily="Consolas" FontSize="10"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
</dx:ThemedWindow>
