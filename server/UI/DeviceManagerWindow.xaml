<dx:ThemedWindow x:Class="SeroServer.UI.DeviceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Device Manager" Width="860" Height="520" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowGlow="False">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}" BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Mouse.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitle" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCount" FontSize="11" Foreground="{DynamicResource FieldLabelBrush}" FontFamily="Consolas" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="&#x27F3;" Height="27" Width="30" Margin="0,0,4,0" Style="{StaticResource SBtn}" FontSize="14" Padding="0" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource FieldLabelBrush}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0"/>
                </Grid>
            </Border>
            <DataGrid x:Name="GridDevs" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource ContentTextBrush}" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="{DynamicResource AlternatingRowBgBrush}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource InputBorderBrush}"
                      HeadersVisibility="Column" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      ContextMenuOpening="GridDevs_ContextMenuOpening"
                      ColumnHeaderStyle="{StaticResource SColHeader}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="24"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background"      Value="{DynamicResource RowSelBgBrush}"/>
                                    <Setter Property="Foreground"      Value="{DynamicResource RowSelTextBrush}"/>
                                    <Setter Property="BorderBrush"     Value="{DynamicResource RowSelBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MnuDevUninstall" Header="Uninstall"    Click="BtnUninstall_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Trash.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem x:Name="MnuDevCopyName"  Header="Copy Name"    Click="GridDevs_CopyName_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Document.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        <MenuItem x:Name="MnuDevCopyId"    Header="Copy Device ID" Click="GridDevs_CopyId_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Price.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        <Separator/>
                        <MenuItem x:Name="MnuDevRefresh"   Header="Refresh"      Click="BtnRefresh_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Audit_ChangeHistory.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME"         Binding="{Binding Name}"         Width="*"/>
                    <DataGridTextColumn Header="CLASS"        Binding="{Binding Class}"         Width="120"/>
                    <DataGridTextColumn Header="STATUS"       Binding="{Binding Status}"        Width="80"/>
                    <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}"  Width="160"/>
                    <DataGridTextColumn Header="DEVICE ID"    Binding="{Binding DeviceId}"      Width="200" FontFamily="Consolas" FontSize="10"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
</dx:ThemedWindow>
