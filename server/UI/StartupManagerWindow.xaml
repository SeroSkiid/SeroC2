<dx:ThemedWindow x:Class="SeroServer.UI.StartupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Startup Manager"
        Width="860" Height="500" MinWidth="640" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowGlow="False">

    <Window.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verified}" Value="False">
                    <Setter Property="BorderBrush" Value="#EF4444"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush"     Value="{DynamicResource RowSelBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellBd" Background="Transparent" Padding="10,4" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Verified}" Value="False">
                                <Setter TargetName="CellBd" Property="Background" Value="#20EF4444"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowHoverBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowSelBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background"  Value="{DynamicResource WindowBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SectionBorderBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.7" Color="#000"/></Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Toolbar: client label + action buttons -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCount" FontSize="11" Foreground="{DynamicResource FieldLabelBrush}" FontFamily="Consolas" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Height="27" Width="30"
                            Style="{StaticResource SBtn}" Padding="0" Click="Refresh_Click" ToolTip="Refresh">
                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Audit_ChangeHistory.svg'}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource FieldLabelBrush}"
                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0"/>
        </Border>

        <!-- Startup list -->
        <DataGrid x:Name="GridStartup"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource ContentTextBrush}"
                  BorderThickness="0" RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource AlternatingRowBgBrush}"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource InputBorderBrush}"
                  HeadersVisibility="Column"
                  FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" SelectionMode="Extended" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserResizeRows="False"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ColumnHeaderStyle="{StaticResource SColHeader}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MnuStupDelete"   Header="Delete Entry" Click="Delete_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Trash.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MnuStupCopyName" Header="Copy Name"    Click="GridStartup_CopyName_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Document.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MnuStupCopyPath" Header="Copy Path"    Click="GridStartup_CopyPath_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Hyperlink.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                    <Separator/>
                    <MenuItem x:Name="MnuStupRefresh"  Header="Refresh"      Click="Refresh_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Refresh.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME"      Binding="{Binding Name}"             Width="200" FontSize="12"/>
                <DataGridTextColumn Header="TYPE"      Binding="{Binding Type}"             Width="70"  FontSize="11"/>
                <DataGridTextColumn Header="LOCATION"  Binding="{Binding Location}"         Width="115" FontSize="11"/>
                <DataGridTemplateColumn Header="PUBLISHER" Width="210" SortMemberPath="PublisherDisplay">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PublisherDisplay}" FontSize="11" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PATH"      Binding="{Binding Path}"             Width="*"   FontSize="11"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</dx:ThemedWindow>
