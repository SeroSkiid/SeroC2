<dx:ThemedWindow x:Class="SeroServer.UI.SpeakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Speaker Loopback"
        Width="480" Height="380" MinWidth="400" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

    <DockPanel LastChildFill="True">
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Headphone.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource TitleLabelBrush}"
                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0"/>
        </Border>

        <!-- Loopback controls -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtLblDevice" Grid.Column="0" Text="Device:" Foreground="{DynamicResource TitleLabelBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbDevice" Height="28"
                              Style="{StaticResource SCombo}" FontSize="11"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnListen" Height="28" Padding="14,0" Margin="0,0,6,0"
                            Style="{StaticResource SGreenBtn}" FontSize="11" Click="Listen_Click"/>
                    <Button x:Name="BtnStop"   Content="Stop" Height="28" Padding="14,0" Margin="0,0,6,0"
                            Style="{StaticResource SRedBtn}" FontSize="11" Click="Stop_Click" IsEnabled="False"/>
                    <Button x:Name="BtnSave"   Height="28" Padding="12,0"
                            Style="{StaticResource SBtn}" FontSize="11" Click="SaveWav_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Waveform -->
        <Border Background="{DynamicResource SidebarCtrlBgBrush}">
            <Grid>
                <Border x:Name="ListeningIndicator" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="14,10" CornerRadius="10" Padding="8,3" Visibility="Collapsed"
                        Background="{DynamicResource SectionBgBrush}" BorderBrush="#3B82F6" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0">
                            <Ellipse.Fill><SolidColorBrush Color="#3B82F6"/></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="TxtRecTime" Text="0:00" Foreground="#3B82F6"
                                   FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Canvas x:Name="WaveCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <StackPanel x:Name="PnlIdle" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Headphone.svg'}" Width="40" Height="40" HorizontalAlignment="Center" Opacity="0.2"/>
                    <TextBlock x:Name="TxtIdleHint" Text="Select device and press Listen"
                               Foreground="{DynamicResource LabelBrush}" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,8,0,0" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</dx:ThemedWindow>
