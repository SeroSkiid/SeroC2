<dx:ThemedWindow x:Class="SeroServer.UI.FunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Fun"
        Width="580" Height="640" MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

    <Window.Resources>
        <Style x:Key="FBtn" TargetType="Button">
            <Setter Property="Background"       Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground"       Value="{DynamicResource BtnFgBrush}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource BtnBorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Margin"           Value="0,0,5,4"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Bg" Property="Background"   Value="{DynamicResource NavHoverBgBrush}"/>
                                <Setter TargetName="PART_Bg" Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Bg" Property="Background"   Value="{DynamicResource BtnPressedBgBrush}"/>
                            </Trigger>
                            <!-- Inactive: partner was clicked &#176; heavily dimmed -->
                            <Trigger Property="Tag" Value="off">
                                <Setter TargetName="PART_Bg" Property="Background"  Value="{DynamicResource WindowBgBrush}"/>
                                <Setter TargetName="PART_Bg" Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}"/>
                                <Setter Property="Foreground"                        Value="{DynamicResource FieldLabelBrush}"/>
                                <Setter Property="Opacity"                           Value="0.6"/>
                            </Trigger>
                            <!-- Active state: thick left accent + blue fill &#176; clearly visible on all variants -->
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="PART_Bg" Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="PART_Bg" Property="BorderThickness" Value="3,1,1,1"/>
                                <Setter TargetName="PART_Bg" Property="Background"      Value="{DynamicResource NavSelBgBrush}"/>
                                <Setter Property="Foreground"                            Value="{DynamicResource NavSelTextBrush}"/>
                                <Setter Property="Opacity"                               Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FBtnGreen"  TargetType="Button" BasedOn="{StaticResource FBtn}">
            <Setter Property="BorderBrush" Value="#2A4A28"/>
        </Style>
        <Style x:Key="FBtnRed"   TargetType="Button" BasedOn="{StaticResource FBtn}">
            <Setter Property="BorderBrush" Value="#4A2028"/>
        </Style>
        <Style x:Key="FBtnOrange" TargetType="Button" BasedOn="{StaticResource FBtn}">
            <Setter Property="BorderBrush" Value="#4A3A18"/>
        </Style>
        <Style x:Key="FBtnPurple" TargetType="Button" BasedOn="{StaticResource FBtn}">
            <Setter Property="Foreground" Value="#cba6f7"/>
            <Setter Property="BorderBrush" Value="#3A2858"/>
        </Style>
        <!-- Override DX scrollbar theme within this window -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels"  Value="True"/>
            <Setter Property="Width"    Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="8" SnapsToDevicePixels="True">
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4" Opacity="0.6"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" IsTabStop="False" Focusable="False"/></Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="40">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="Bd" Background="{DynamicResource AccentBrush}" CornerRadius="4" Margin="2,0" Opacity="0.55"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.80"/></Trigger>
                                                    <Trigger Property="IsDragging"  Value="True"><Setter TargetName="Bd" Property="Opacity" Value="1.0"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" IsTabStop="False" Focusable="False"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FSection" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource TitleBgBrush}"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource SectionBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource LabelBrush}"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
        </Style>
    </Window.Resources>

        <DockPanel LastChildFill="True">

            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource TitleBgBrush}" BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle" Text="" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource LabelBrush}"
                               FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0"/>
                </Grid>
            </Border>

            <!-- Main content: two-column grid -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">

                        <!-- CD-ROM -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunCdRom" Text="CD-ROM" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnCdEject" Content="Eject"  Style="{StaticResource FBtn}" Click="CdOpen_Click"/>
                                    <Button x:Name="BtnCdClose" Content="Close"  Style="{StaticResource FBtn}" Click="CdClose_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Taskbar -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunTaskbar" Text="Taskbar" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnTaskbarShow" Content="Show"  Style="{StaticResource FBtnGreen}" Click="TaskbarShow_Click"/>
                                    <Button x:Name="BtnTaskbarHide" Content="Hide"  Style="{StaticResource FBtnRed}"   Click="TaskbarHide_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Explorer -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xEC50;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunExplorer" Text="Explorer" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnExplorerKill"  Content="Kill"  Style="{StaticResource FBtnRed}"   Click="ExplorerKill_Click"/>
                                    <Button x:Name="BtnExplorerStart" Content="Start" Style="{StaticResource FBtnGreen}" Click="ExplorerStart_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Screen -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunScreen" Text="Screen" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnScreenOn"  Content="On"  Style="{StaticResource FBtnGreen}" Click="ScreenOn_Click"/>
                                    <Button x:Name="BtnScreenOff" Content="Off" Style="{StaticResource FBtnRed}"   Click="ScreenOff_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Clock -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunClockTray" Text="Clock / Tray" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnClockShow" Content="Clock Show"  Style="{StaticResource FBtnGreen}" Click="ClockShow_Click"/>
                                    <Button x:Name="BtnClockHide" Content="Clock Hide"  Style="{StaticResource FBtnRed}"   Click="ClockHide_Click"/>
                                    <Button x:Name="BtnTrayShow"  Content="Tray Show"   Style="{StaticResource FBtnGreen}" Click="TrayShow_Click"/>
                                    <Button x:Name="BtnTrayHide"  Content="Tray Hide"   Style="{StaticResource FBtnRed}"   Click="TrayHide_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Desktop Icons -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8FC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunDesktop" Text="Desktop Icons" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnDesktopIconsShow" Content="Show"  Style="{StaticResource FBtnGreen}" Click="DesktopIconsShow_Click"/>
                                    <Button x:Name="BtnDesktopIconsHide" Content="Hide"  Style="{StaticResource FBtnRed}"   Click="DesktopIconsHide_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Volume -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunVolume" Text="Volume" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnVolUp"   Content="+ Vol" Style="{StaticResource FBtnGreen}"  Click="VolUp_Click"/>
                                    <Button x:Name="BtnVolDown" Content="- Vol" Style="{StaticResource FBtnOrange}" Click="VolDown_Click"/>
                                    <Button x:Name="BtnVolMute" Content="Mute"  Style="{StaticResource FBtnRed}"    Click="VolMute_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <!-- Mouse -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunMouse" Text="Mouse" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnMouseNormal" Content="Normal" Style="{StaticResource FBtnGreen}" Click="MouseNormal_Click"/>
                                    <Button x:Name="BtnMouseSwap"   Content="Swap"   Style="{StaticResource FBtnRed}"   Click="MouseSwap_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Screen Rotation -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunScreenRot" Text="Screen Rotation" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="BtnFlip0"   Content="0&#176;"   Width="44" Style="{StaticResource FBtn}"       Click="Flip0_Click"/>
                                    <Button x:Name="BtnFlip90"  Content="90&#176;"  Width="44" Style="{StaticResource FBtnOrange}" Click="Flip90_Click"/>
                                    <Button x:Name="BtnFlip180" Content="180&#176;" Width="48" Style="{StaticResource FBtnOrange}" Click="Flip180_Click"/>
                                    <Button x:Name="BtnFlip270" Content="270&#176;" Width="48" Style="{StaticResource FBtnOrange}" Click="Flip270_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Crazy Mouse -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunCrazyMouse" Text="Crazy Mouse" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtCrazyMouseSec" Text="10" Width="40" Height="28"
                                             Background="{DynamicResource SidebarCtrlBgBrush}" Foreground="{DynamicResource ContentTextBrush}"
                                             BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                             Padding="4,3" FontFamily="Consolas" FontSize="11"
                                             Margin="0,0,4,0"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource STxt}"/>
                                    <TextBlock x:Name="LblFunSec" Text="sec" Foreground="{DynamicResource LabelBrush}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCrazyActivate" Content="Activate" Style="{StaticResource FBtnOrange}" Click="CrazyMouse_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Text Speak -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunTts" Text="Text to Speech" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <TextBox x:Name="TxtSpeak" Text="Hello World"
                                         Background="{DynamicResource SidebarCtrlBgBrush}" Foreground="{DynamicResource ContentTextBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                         Padding="6,4" FontFamily="Consolas" FontSize="11"
                                         Margin="0,0,0,6" Height="28" VerticalContentAlignment="Center"
                                         Style="{StaticResource STxt}"/>
                                <Button x:Name="BtnSpeak" Content="Speak" HorizontalAlignment="Left" Style="{StaticResource FBtnPurple}" Click="Speak_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Message Box -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunMsgbox" Text="Message Box" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <TextBox x:Name="TxtMsgBox" Text="Surprise!"
                                         Background="{DynamicResource SidebarCtrlBgBrush}" Foreground="{DynamicResource ContentTextBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                         Padding="6,4" FontFamily="Consolas" FontSize="11"
                                         Margin="0,0,0,6" Height="28" VerticalContentAlignment="Center"
                                         Style="{StaticResource STxt}"/>
                                <Button x:Name="BtnMsgShow" Content="Show" HorizontalAlignment="Left" Style="{StaticResource FBtnOrange}" Click="MsgBox_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Open URL -->
                        <Border Style="{StaticResource FSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Width="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource LabelBrush}"/>
                                    <TextBlock x:Name="LblFunOpenUrl" Text="Open URL (on victim)" Style="{StaticResource SectionLabel}" Margin="0"/>
                                </StackPanel>
                                <TextBox x:Name="TxtUrl" Text="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
                                         Background="{DynamicResource SidebarCtrlBgBrush}" Foreground="{DynamicResource ContentTextBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                         Padding="6,4" FontFamily="Consolas" FontSize="10"
                                         Margin="0,0,0,6" Height="26" VerticalContentAlignment="Center"
                                         Style="{StaticResource STxt}"/>
                                <Button x:Name="BtnOpenUrl" Content="Open" HorizontalAlignment="Left" Style="{StaticResource FBtnPurple}" Click="OpenUrl_Click"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

        </DockPanel>
</dx:ThemedWindow>
