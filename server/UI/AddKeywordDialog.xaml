<Window x:Class="SeroServer.UI.AddKeywordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Notify"
        Width="380" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1" Padding="20">
        <StackPanel>
            <TextBlock x:Name="LblPrompt" Text="" Style="{StaticResource SLabel}" />
            <TextBox x:Name="TxtKeyword" Style="{StaticResource STxt}" Margin="0,0,0,14"
                     KeyDown="TxtKeyword_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Width="80" Style="{StaticResource SBtn}" Click="Cancel_Click" />
                <Button Content="OK" Width="80" Margin="8,0,0,0" Style="{StaticResource SGreenBtn}" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
