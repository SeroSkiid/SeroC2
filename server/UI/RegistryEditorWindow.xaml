<dx:ThemedWindow x:Class="SeroServer.UI.RegistryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Registry Editor" Width="1020" Height="620" MinWidth="740" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowGlow="False">

    <Window.Resources>
        <Style TargetType="TreeView">
            <Setter Property="Background"   Value="{DynamicResource SectionBgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"   Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="Padding"      Value="4"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground"   Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Padding"      Value="2,3"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="IsExpanded"   Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelBgBrush}"/>
                                    <Setter Property="Foreground"      Value="{DynamicResource RowSelTextBrush}"/>
                                    <Setter Property="BorderBrush"     Value="{DynamicResource RowSelBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource NavHoverBgBrush}"/></Trigger>
                <Trigger Property="IsSelected"  Value="True">
                    <Setter Property="Background"      Value="{DynamicResource RowSelBgBrush}"/>
                    <Setter Property="Foreground"      Value="{DynamicResource RowSelTextBrush}"/>
                    <Setter Property="BorderBrush"     Value="{DynamicResource RowSelBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,4"><ContentPresenter VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SectionBorderBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.7" Color="#000"/></Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}" BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/registry.png" Width="14" Height="14" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitle" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Path / address bar -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarCtrlBgBrush}" BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x25B6;" Foreground="{DynamicResource FieldLabelBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtPath" Grid.Column="1" Height="28" Style="{StaticResource STxt}"
                             FontSize="11" FontFamily="Consolas" KeyDown="TxtPath_KeyDown"/>
                    <Button Grid.Column="2" Content="Go" Height="28" Padding="14,0" Margin="6,0,0,0"
                            Style="{StaticResource SBtn}" FontSize="11" Click="BtnGo_Click"/>
                </Grid>
            </Border>


            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource InputBgBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource FieldLabelBrush}"
                               FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0"/>
                </Grid>
            </Border>

            <!-- Main content: TreeView | splitter | DataGrid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="160"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Registry key tree -->
                <TreeView x:Name="RegTree" Grid.Column="0"
                          Background="{DynamicResource SectionBgBrush}" BorderThickness="0"
                          SelectedItemChanged="RegTree_SelectedItemChanged"
                          ContextMenuOpening="RegTree_ContextMenuOpening">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MnuRegNewKey"    Header="New Key"    Click="BtnNewKey_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_FileAttachment.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="MnuRegDeleteKey" Header="Delete Key" Click="BtnDeleteKey_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Trash.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem x:Name="MnuRegRefresh"   Header="Refresh"    Click="TreeRefresh_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Audit_ChangeHistory.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="{DynamicResource InputBgBrush}" Cursor="SizeWE"/>

                <!-- Registry values -->
                <DataGrid x:Name="GridValues" Grid.Column="2"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource ContentTextBrush}" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="{DynamicResource AlternatingRowBgBrush}"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource SectionBorderBrush}" VerticalGridLinesBrush="{DynamicResource SectionBorderBrush}"
                          HeadersVisibility="Column" FontFamily="Consolas" FontSize="11"
                          SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          EnableColumnVirtualization="True"
                          ScrollViewer.CanContentScroll="True"
                          ColumnHeaderStyle="{StaticResource SColHeader}"
                          ContextMenuOpening="GridValues_ContextMenuOpening"
                          MouseDoubleClick="GridValues_DoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MnuRegEditVal"   Header="Edit Value"   Click="EditValue_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Document.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="MnuRegDeleteVal" Header="Delete Value" Click="BtnDeleteValue_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Trash.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem x:Name="MnuRegNewVal"    Header="New Value"    Click="BtnNewValue_Click"><MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_FileAttachment.svg'}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="NAME" Width="180" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ValIcon" Text="&#x25A1;" FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding ValueType}" Width="90"  Foreground="{DynamicResource FieldLabelBrush}"/>
                        <DataGridTextColumn Header="DATA" Binding="{Binding Data}"      Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>
</dx:ThemedWindow>
