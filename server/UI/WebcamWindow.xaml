<dx:ThemedWindow x:Class="SeroServer.UI.WebcamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Remote Webcam"
        Width="700" Height="520" MinWidth="420" MinHeight="320"
        ResizeMode="CanResize"
        ShowGlow="False">

    <dx:ThemedWindow.Resources>

        <!-- Gradient slider — same as HVNC / RDP -->
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Cursor="Hand" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Cursor="Hand">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                            <GradientStop Color="#7C5CE8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="tb" Width="12" Height="12" Fill="{DynamicResource AccentBrush}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="tb" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="{DynamicResource SectionBorderBrush}" CornerRadius="1.5" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </dx:ThemedWindow.Resources>

    <DockPanel LastChildFill="True">

        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <!-- Left: client ID + LIVE badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Video.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtClientId" Text="" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="TxtClientId_MouseLeftButtonUp" ToolTip="Click to copy ID"/>
                    <Border x:Name="LiveBadge" Margin="12,0,0,0" CornerRadius="3"
                            Background="#0C2016" BorderBrush="#1A6040" BorderThickness="1"
                            Padding="6,2" Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#22C55E"
                                     VerticalAlignment="Center" Margin="0,0,5,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#22C55E" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="LIVE" Foreground="#22C55E"
                                       FontSize="9" FontWeight="Bold" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Right: RDP button + FPS pill + fullscreen -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRemoteDesktop" ToolTip="Open Remote Desktop" Width="28" Height="26" Margin="0,0,8,0"
                            Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1"
                            Cursor="Hand" Padding="0" Click="BtnRemoteDesktop_Click">
                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Appearance.svg'}" Width="14" Height="14"/>
                    </Button>
                    <Border Margin="0,0,12,0" Padding="8,3" CornerRadius="3"
                            Background="{DynamicResource SidebarCtrlBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPing" Text="? ms" Foreground="{DynamicResource FieldLabelBrush}"
                                       FontSize="10" FontFamily="Segoe UI Mono"
                                       MinWidth="38" TextAlignment="Right" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtBandwidth" Text="? Mbps" Foreground="{DynamicResource FieldLabelBrush}"
                                       FontSize="10" FontFamily="Segoe UI Mono"
                                       MinWidth="54" TextAlignment="Right" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtFps" Text="? fps" Foreground="{DynamicResource FieldLabelBrush}"
                                       FontSize="10" FontFamily="Segoe UI Mono"
                                       MinWidth="44" TextAlignment="Right" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SignalIcon" Text="&#xEB44;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="{DynamicResource FieldLabelBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnMenu" Height="26" Padding="8,0" Margin="0,0,4,0"
                            Style="{StaticResource SBtn}" FontSize="11" ToolTip="Actions" Click="BtnMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Ellipsis.svg'}" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnActions" Text="Actions" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFullscreen" Content="&#x26F6;" Width="28" Height="26" Margin="0,0,4,0"
                            Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1"
                            Foreground="{DynamicResource LabelBrush}" FontSize="13" Cursor="Hand" Padding="0"
                            Click="BtnFullscreen_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource TitleBgBrush}" Padding="12,8"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,1">
            <DockPanel LastChildFill="False">

                <!-- Right: AUTO START toggle + START / STOP -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoStart" Content="AUTO START"
                              ToolTip="Automatically start streaming when the window opens"
                              IsChecked="False" VerticalAlignment="Center" Margin="0,0,10,0"
                              Foreground="{DynamicResource TitleTextBrush}" FontSize="10" FontWeight="SemiBold" Cursor="Hand"
                              Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                    <Button x:Name="BtnStart" Content="START" Width="76" Height="26"
                            Style="{StaticResource SGreenBtn}" Click="BtnStart_Click"
                            FontSize="10" FontWeight="Bold" FontFamily="Segoe UI Variable Text, Segoe UI" Padding="14,3"/>
                    <Button x:Name="BtnStop" Content="STOP" Width="70" Height="26" Margin="5,0,0,0"
                            Style="{StaticResource SRedBtn}" Click="BtnStop_Click"
                            IsEnabled="False" Opacity="0.35"
                            FontSize="10" FontWeight="Bold" FontFamily="Segoe UI Variable Text, Segoe UI" Padding="14,3"/>
                </StackPanel>

                <!-- Right-2: Quality + FPS sliders -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,14,0" ClipToBounds="True">
                    <Rectangle Width="1" Height="16" Margin="0,0,14,0" Fill="{DynamicResource SectionBorderBrush}"/>
                    <TextBlock Text="QUALITY" Foreground="{DynamicResource TitleTextBrush}" FontSize="9" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldQuality" Minimum="20" Maximum="95" Value="20" Width="72"
                            Style="{StaticResource SlimSlider}"/>
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                            Background="{DynamicResource SidebarCtrlBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="TxtQuality" Text="20" Foreground="{DynamicResource LabelBrush}"
                                   FontSize="10" FontFamily="Segoe UI Mono"
                                   Width="18" TextAlignment="Center"/>
                    </Border>
                    <Rectangle Width="1" Height="16" Margin="12,0" Fill="{DynamicResource SectionBorderBrush}"/>
                    <TextBlock Text="FPS" Foreground="{DynamicResource TitleTextBrush}" FontSize="9" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldFps" Minimum="5" Maximum="30" Value="20" Width="58"
                            Style="{StaticResource SlimSlider}"/>
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                            Background="{DynamicResource SidebarCtrlBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="TxtFpsVal" Text="20" Foreground="{DynamicResource LabelBrush}"
                                   FontSize="10" FontFamily="Segoe UI Mono"
                                   Width="18" TextAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Left: device selector + resolution -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DEVICE" Foreground="{DynamicResource TitleTextBrush}" FontSize="9" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbDevice" MinWidth="180" Width="Auto" MaxWidth="320" Height="26"
                              Style="{StaticResource SCombo}"/>
                    <Rectangle Width="1" Height="16" Margin="12,0" Fill="{DynamicResource SectionBorderBrush}"/>
                    <TextBlock Text="RES" Foreground="{DynamicResource TitleTextBrush}" FontSize="9" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbResolution" Width="72" Height="26"
                              Style="{StaticResource SCombo}" SelectedIndex="0">
                        <ComboBoxItem Content="Native"/>
                        <ComboBoxItem Content="720p"/>
                        <ComboBoxItem Content="480p"/>
                        <ComboBoxItem Content="360p"/>
                        <ComboBoxItem Content="240p"/>
                    </ComboBox>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource InputBorderBrush}"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtStatus" Text="Waiting for device list..."
                               Foreground="{DynamicResource TitleTextBrush}" FontSize="10" FontFamily="Segoe UI Variable Text, Segoe UI"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoSave" Content="AUTO-SAVE"
                              Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold"
                              IsEnabled="False" Opacity="0.4" Margin="0,0,8,0" Cursor="Hand"
                              Checked="ChkAutoSave_Changed" Unchecked="ChkAutoSave_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Video canvas -->
        <Grid>
            <Rectangle Fill="#020306"/>
            <Image x:Name="ImgFrame"
                   Stretch="UniformToFill"
                   Cursor="Arrow"/>

            <!-- Placeholder shown before streaming starts -->
            <TextBlock x:Name="TxtPlaceholder"
                       Text="Waiting for device list..."
                       Foreground="{DynamicResource FieldLabelBrush}" FontSize="13" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

            <!-- Debug log overlay (hidden by default) -->
            <Border x:Name="LogPanel" VerticalAlignment="Bottom" MaxHeight="160"
                    Background="#CC020306" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="10"
                               Foreground="#88AABBCC" Padding="10,6" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Reconnecting overlay -->
            <Grid x:Name="ReconnectOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                <Rectangle Fill="#CC000000"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtReconnectIcon" Text="⟳" FontSize="36" Foreground="#60A5FA"
                               HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.3" To="1.0" Duration="0:0:0.8"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="Connection lost" Foreground="{DynamicResource ContentTextBrush}" FontSize="16"
                               FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtReconnectCountdown" Text="Reconnecting... (60s)"
                               Foreground="#94A3B8" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

    </DockPanel>
</dx:ThemedWindow>
