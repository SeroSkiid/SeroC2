<dx:ThemedWindow x:Class="SeroServer.UI.FakeUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Fake Update"
        Width="440" Height="310" MinWidth="360" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowGlow="False">

    <DockPanel LastChildFill="True">
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Download.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource TitleLabelBrush}"
                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0"/>
        </Border>

        <Border Background="{DynamicResource SectionBgBrush}" Padding="20,18">
            <StackPanel>
                <!-- Duration -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtLblDuration" Grid.Column="0" Text="Duration (min):"
                               Foreground="{DynamicResource TitleLabelBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TxtDuration" Height="26"
                             Style="{StaticResource STxt}" FontSize="11" FontFamily="Consolas"
                             Text="0" ToolTip="0 = infinite"/>
                    <TextBlock Grid.Column="2" Text="  (0 = infinite)"
                               Foreground="{DynamicResource LabelBrush}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>

                <!-- Reboot after -->
                <CheckBox x:Name="ChkReboot" Margin="0,0,0,14" IsChecked="True"
                          Foreground="{DynamicResource TitleLabelBrush}" FontSize="11"
                          FontFamily="Segoe UI Variable Text, Segoe UI">
                    <TextBlock x:Name="TxtLblReboot" Text="Restart PC when duration expires"
                               Foreground="{DynamicResource TitleLabelBrush}" FontSize="11"/>
                </CheckBox>

                <!-- Hint box -->
                <Border Background="{DynamicResource TitleBgBrush}" CornerRadius="4"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,16">
                    <TextBlock x:Name="TxtHint" Foreground="{DynamicResource LabelBrush}"
                               FontSize="11" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnShow" Height="28" Padding="14,0" Margin="0,0,6,0"
                            Style="{StaticResource SGreenBtn}" FontSize="11" Click="Show_Click"/>
                    <Button x:Name="BtnHide" Height="28" Padding="14,0"
                            Style="{StaticResource SRedBtn}" FontSize="11" Click="Hide_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</dx:ThemedWindow>
