                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" IsTabStop="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid ControlTemplate: vertical scrollbar spans the full height including column headers.
             Default WPF places the scrollbar only next to data rows, leaving a gap equal to the header height.
             This template moves PART_VerticalScrollBar to RowSpan=2 (header row + data row). -->
        <ControlTemplate x:Key="DataGridFullHeightScrollbar" TargetType="{x:Type DataGrid}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False" Background="Transparent"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Template>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                Grid.Row="0" Grid.Column="0"/>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Grid.Row="1" Grid.Column="0"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                <!-- Vertical scrollbar spans rows 0+1 — full height including column headers -->
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                           Orientation="Vertical"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           Grid.Row="2" Grid.Column="0"
                                           Orientation="Horizontal"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Value="{TemplateBinding HorizontalOffset}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </ScrollViewer.Template>
                    <ItemsPresenter SnapsToDevicePixels="True"/>
                </ScrollViewer>
            </Border>
        </ControlTemplate>

        <!-- Window-level colour tokens ? updated at runtime by ApplyTheme -->
        <SolidColorBrush x:Key="WindowBgBrush"      Color="#0C0D18"/>
        <SolidColorBrush x:Key="TitleBgBrush"       Color="#111222"/>
        <SolidColorBrush x:Key="TitleBorderBrush"   Color="#1E2038"/>
        <SolidColorBrush x:Key="SectionBgBrush"     Color="#D0111222"/>
        <SolidColorBrush x:Key="SectionBorderBrush" Color="#1E2038"/>
        <SolidColorBrush x:Key="ActivityBgBrush"    Color="#C0111222"/>

        <!-- Nav button / sidebar colour tokens ? updated at runtime by ApplyTheme -->
        <SolidColorBrush x:Key="NavIconBrush"           Color="#404868"/>
        <SolidColorBrush x:Key="NavTextBrush"           Color="#505878"/>
        <SolidColorBrush x:Key="NavHoverBgBrush"        Color="#0E1128"/>
        <SolidColorBrush x:Key="NavHoverIconBrush"      Color="#6070A0"/>
        <SolidColorBrush x:Key="NavHoverTextBrush"      Color="#8090B8"/>
        <SolidColorBrush x:Key="NavSelBgBrush"          Color="#131628"/>
        <SolidColorBrush x:Key="NavSelTextBrush"        Color="#DDE0F0"/>
        <SolidColorBrush x:Key="NavSelIconBrush"        Color="#4A85F5"/>
        <SolidColorBrush x:Key="NavSectionBrush"        Color="#303560"/>
        <SolidColorBrush x:Key="SidebarCtrlBgBrush"    Color="#0D0E1A"/>
        <SolidColorBrush x:Key="SidebarCtrlBorderBrush" Color="#1C2040"/>
        <SolidColorBrush x:Key="SidebarCtrlTextBrush"   Color="#7080A8"/>
        <!-- Content / input tokens ? pre-seeded with SeroDark defaults to prevent white-border flash on first theme load -->
        <SolidColorBrush x:Key="InputBgBrush"          Color="#0D0E1A"/>
        <SolidColorBrush x:Key="InputBorderBrush"      Color="#1E2038"/>
        <SolidColorBrush x:Key="ContentTextBrush"      Color="#DDE0F0"/>
        <SolidColorBrush x:Key="LabelBrush"            Color="#A0AAC8"/>
        <SolidColorBrush x:Key="FieldLabelBrush"       Color="#8090B4"/>
        <SolidColorBrush x:Key="BtnBgBrush"            Color="#141526"/>
        <SolidColorBrush x:Key="BtnBorderBrush"        Color="#1E2038"/>
        <SolidColorBrush x:Key="BtnHoverBgBrush"       Color="#1A1B2E"/>
        <SolidColorBrush x:Key="BtnHoverBorderBrush"   Color="#2A2D50"/>
        <SolidColorBrush x:Key="BtnPressedBgBrush"     Color="#0E0F1A"/>
        <SolidColorBrush x:Key="BtnFgBrush"            Color="#DDE0F0"/>
        <SolidColorBrush x:Key="CardBgBrush"           Color="#0A0D1A"/>
        <SolidColorBrush x:Key="ChartBgBrush"          Color="#07080F"/>
        <SolidColorBrush x:Key="ProgressTrackBrush"    Color="#13172A"/>
        <!-- Container corner radius — updated at runtime by ApplyTheme per theme aesthetic -->
        <CornerRadius x:Key="ContainerCornerRadius">3</CornerRadius>
    </dx:ThemedWindow.Resources>

    <!-- Window chrome -->
    <Border x:Name="OutlineBorder">
        <Grid Background="{DynamicResource WindowBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"  />
            </Grid.RowDefinitions>

            <!-- Background -->
            <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">

                <Rectangle Fill="{DynamicResource WindowBgBrush}"/>

                <!-- Logo watermark centr? -->
                <Image x:Name="BgLogoImage"
                       Source="/serofondtransparent.png"
                       Width="160" Height="160"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="215,0,0,28"
                       Opacity="0.08"
                       Visibility="Collapsed"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderOptions.CachingHint="Cache">
                    <Image.Effect>
                        <BlurEffect x:Name="BgLogoBlur" Radius="0"/>
                    </Image.Effect>
                </Image>

            </Grid>

            <!-- Screenshot popup overlay (click-to-enlarge) -->
            <Grid x:Name="ScreenPopupOverlay" Grid.RowSpan="2" Panel.ZIndex="200"
                  Background="#D0060810" Visibility="Collapsed"
                  MouseLeftButtonDown="ScreenPopupOverlay_Close">
                <Border Background="#0C0E1E" CornerRadius="10" BorderThickness="1" BorderBrush="#2A3060"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="16" MinWidth="300" MaxWidth="1100"
                        MouseLeftButtonDown="ScreenPopupOverlay_StopBubble">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="ScreenPopupTitle" Foreground="#CCD8FF" FontSize="12"
                                       FontFamily="Consolas" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Content="?" Width="22" Height="22"
                                    Foreground="{DynamicResource LabelBrush}" Background="Transparent" BorderThickness="0"
                                    FontSize="12" Cursor="Hand"
                                    Click="ScreenPopupOverlay_CloseBtn"/>
                        </Grid>
                        <Image x:Name="ScreenPopupImage" Stretch="Uniform"
                               MaxHeight="680" MaxWidth="1068"/>
                        <TextBlock x:Name="ScreenPopupSub" Foreground="#404878" FontSize="10"
                                   FontFamily="Consolas" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Accent line: full-width repeating aurora -->
            <Rectangle x:Name="AuroraBar" Grid.Row="0" Height="3" Visibility="Collapsed">
                <Rectangle.Fill>
                    <LinearGradientBrush MappingMode="Absolute"
                                         StartPoint="0,0" EndPoint="600,0"
                                         SpreadMethod="Repeat">
                        <LinearGradientBrush.Transform>
                            <TranslateTransform X="0"/>
                        </LinearGradientBrush.Transform>
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.00"/>
                        <GradientStop Color="#0DCCFF" Offset="0.20"/>
                        <GradientStop Color="#5B9BD5" Offset="0.42"/>
                        <GradientStop Color="#D040FF" Offset="0.58"/>
                        <GradientStop Color="#5B9BD5" Offset="0.76"/>
                        <GradientStop Color="#0DCCFF" Offset="0.90"/>
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="1.00"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="Rectangle.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="AuroraBar"
                                    Storyboard.TargetProperty="(Rectangle.Fill).(LinearGradientBrush.Transform).(TranslateTransform.X)"
                                    From="0" To="-600" Duration="0:0:5"
                                    RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>

            <!-- Main area (sidebar + content) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left sidebar -->
                <Border x:Name="SidebarPanel" Grid.Column="0"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderThickness="0">
                    <DockPanel>

                        <!-- SeroRAT brand header ? logo only, no duplicate text -->
                        <Border DockPanel.Dock="Top" Padding="8,2,8,2"
                                BorderBrush="{DynamicResource SidebarCtrlBorderBrush}" BorderThickness="0,0,0,1">
                            <Image Source="/serofondtransparent.png" Width="82" Height="82"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform"/>
                        </Border>

                        <!-- Server controls -->
                        <Border DockPanel.Dock="Top" Padding="12,14,12,12"
                                BorderBrush="{DynamicResource SidebarCtrlBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <!-- Port + Start/Stop -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource SidebarCtrlBgBrush}"
                                            CornerRadius="5"
                                            BorderBrush="{DynamicResource SidebarCtrlBorderBrush}" BorderThickness="1"
                                            Padding="10,0" Height="30">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="PORT"
                                                       Foreground="{DynamicResource SidebarCtrlTextBrush}" FontSize="9"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text=":" Foreground="{DynamicResource SidebarCtrlTextBrush}"
                                                       FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="TxtPort"
                                                     Style="{StaticResource STxt}" Text="7777"
                                                     BorderThickness="0" Background="Transparent"
                                                     Padding="0" FontSize="12" FontWeight="SemiBold"
                                                     MaxLength="5" Width="46" VerticalAlignment="Center"
                                                     PreviewTextInput="TxtPort_PreviewTextInput"
                                                     DataObject.Pasting="TxtPort_Pasting"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="1" x:Name="BtnStartStop" Content="START"
                                            Style="{StaticResource SGreenBtn}" Click="StartStop_Click"
                                            Width="64" Height="30" Padding="0" Margin="6,0,0,0"
                                            FontSize="11" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Status indicator -->
                                <Border Background="{DynamicResource SidebarCtrlBgBrush}" CornerRadius="5" Padding="10,6"
                                        BorderBrush="{DynamicResource SidebarCtrlBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="14" Height="14" VerticalAlignment="Center"
                                              Margin="0,0,6,0">
                                            <Ellipse x:Name="ServerDot" Width="7" Height="7"
                                                     Fill="#EF4444" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="TxtServerStatus" Text="Stopped"
                                                   Foreground="{DynamicResource SidebarCtrlTextBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtClientCount" Text="  &#xB7;  0 clients"
                                                   Foreground="{DynamicResource SidebarCtrlTextBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Backup / Import -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnBackup" Grid.Column="0" Content="Backup"
                                            Style="{StaticResource SBtn}" Height="26"
                                            Padding="0" FontSize="11" Margin="0,0,4,0"
                                            Click="ExportBackup_Click"
                                            ToolTip="Export cert + auth key (.sero)"/>
                                    <Button x:Name="BtnImport" Grid.Column="1" Content="Import"
                                            Style="{StaticResource SBtn}" Height="26"
                                            Padding="0" FontSize="11"
                                            Click="ImportBackup_Click"
                                            ToolTip="Import .sero backup or .pfx cert"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Navigation items -->
                        <ScrollViewer DockPanel.Dock="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="NavSectionMain" Text="MAIN" Foreground="{DynamicResource NavSectionBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Margin="16,2,0,3"/>
                                <RadioButton x:Name="NavDashboard" GroupName="NavGroup"
                                             IsChecked="True"
                                             Style="{StaticResource NavBtn}"
                                             Content="Dashboard"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Dashboard.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavOnline" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="Online"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Contact.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavAllClients" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="All Clients"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Customer.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>

                                <TextBlock x:Name="NavSectionTools" Text="TOOLS" Foreground="{DynamicResource NavSectionBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Margin="16,10,0,3"/>
                                <RadioButton x:Name="NavBuilder" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="Builder"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Project.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavAutoTask" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="AutoTask"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Clock.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavScreen" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="Screen"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_DesktopWindows.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavClipper" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="Clipper"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Edit/Paste.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavBinder" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="Binder"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_FileAttachment.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavWinNotify" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="Window Notify"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Bell.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>

                                <TextBlock x:Name="NavSectionSystem" Text="SYSTEM" Foreground="{DynamicResource NavSectionBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Margin="16,10,0,3"/>
                                <RadioButton x:Name="NavLogs" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="Logs"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Document.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavSettings" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="Settings"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Settings.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                                <RadioButton x:Name="NavAbout" GroupName="NavGroup"
                                             Style="{StaticResource NavBtn}"
                                             Content="About"
                                             Checked="Nav_Checked">
                                    <RadioButton.Tag>
                                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Outlook Inspired/About.svg'}" Width="16" Height="16"/>
                                    </RadioButton.Tag>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1"
                           Fill="{DynamicResource SidebarBorderBrush}" IsHitTestVisible="False"/>

                <!-- Tab content (no tab strip) -->
                <TabControl x:Name="MainTabControl" Grid.Column="1"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextBrush}"
                            SelectionChanged="MainTabControl_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"/>
                        </ControlTemplate>
                    </TabControl.Template>

                <!--  Dashboard -  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE179;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Margin="8" Padding="16,14" CornerRadius="{DynamicResource ContainerCornerRadius}"
                            Background="{DynamicResource SectionBgBrush}" BorderThickness="1"
                            TextElement.FontFamily="Segoe UI">
                        <Border.BorderBrush><DynamicResource ResourceKey="SectionBorderBrush"/></Border.BorderBrush>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel MinWidth="520">

                                <!-- Header -->
                                <Grid Margin="0,0,0,16">
                                    <TextBlock x:Name="DashLblOverview" Text="OVERVIEW" Style="{StaticResource SLabel}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="DashLblLastUpdated" Text="Last updated " Foreground="{DynamicResource LabelBrush}" FontSize="9" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DashLastUpdated" Text="--" Foreground="{DynamicResource LabelBrush}" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: 4 stat cards -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="120"/><ColumnDefinition MinWidth="120"/><ColumnDefinition MinWidth="120"/><ColumnDefinition MinWidth="120"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ONLINE -->
                                    <Border Grid.Column="0" CornerRadius="{DynamicResource ContainerCornerRadius}" Margin="0,0,9,0" ClipToBounds="True" Background="{DynamicResource CardBgBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#22C55E"/>
                                            <StackPanel Grid.Column="1" Margin="14,15,12,15">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="#22C55E" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="DashLblOnline" Text="ONLINE" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="DashOnline" Text="0" Foreground="#22C55E" FontSize="34" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashSubOnline" Text="connected now" Foreground="{DynamicResource LabelBrush}" FontSize="9" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- TOTAL SEEN -->
                                    <Border Grid.Column="1" CornerRadius="{DynamicResource ContainerCornerRadius}" Margin="0,0,9,0" ClipToBounds="True" Background="{DynamicResource CardBgBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="{DynamicResource AccentBrush}"/>
                                            <StackPanel Grid.Column="1" Margin="14,15,12,15">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="DashLblTotal" Text="TOTAL SEEN" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="DashTotal" Text="0" Foreground="{DynamicResource AccentBrush}" FontSize="34" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashSubTotal" Text="unique clients" Foreground="{DynamicResource LabelBrush}" FontSize="9" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- NEW 24H -->
                                    <Border Grid.Column="2" CornerRadius="{DynamicResource ContainerCornerRadius}" Margin="0,0,9,0" ClipToBounds="True" Background="{DynamicResource CardBgBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#F59E0B"/>
                                            <StackPanel Grid.Column="1" Margin="14,15,12,15">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="#F59E0B" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="DashLblNew24h" Text="NEW 24H" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="DashNew24h" Text="0" Foreground="#F59E0B" FontSize="34" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashSubNew24h" Text="connections today" Foreground="{DynamicResource LabelBrush}" FontSize="9" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- UPTIME -->
                                    <Border Grid.Column="3" CornerRadius="{DynamicResource ContainerCornerRadius}" ClipToBounds="True" Background="{DynamicResource CardBgBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#5B9BD5"/>
                                            <StackPanel Grid.Column="1" Margin="14,15,12,15">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                    <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="#5B9BD5" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="DashLblUptime" Text="UPTIME" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="DashUptime" Text="--" Foreground="#5B9BD5" FontSize="20" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DashSubUptime" Text="server running" Foreground="{DynamicResource LabelBrush}" FontSize="9" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Row 2: chart + OS breakdown -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" MinWidth="200"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="180" MinWidth="160"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Activity chart -->
                                    <Border Grid.Column="0" Background="{DynamicResource ChartBgBrush}" CornerRadius="{DynamicResource ContainerCornerRadius}"
                                            BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}" ClipToBounds="True">
                                        <StackPanel>
                                            <Grid Margin="14,11,14,8">
                                                <TextBlock x:Name="DashLblConnChart" Text="CONNECTIONS · LAST 24H" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="peak " Foreground="{DynamicResource LabelBrush}" FontSize="9"/>
                                                    <TextBlock x:Name="DashPeak" Text="--" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                            <Canvas x:Name="DashChart" Background="Transparent" Height="148" SizeChanged="DashChart_SizeChanged">
                                                <Polyline x:Name="DashChartLine" StrokeThickness="2" StrokeLineJoin="Round" Panel.ZIndex="2"
                                                          Stroke="{DynamicResource AccentBrush}"/>
                                                <Polygon x:Name="DashChartFill" Panel.ZIndex="1" Opacity="0.18"
                                                         Fill="{DynamicResource AccentBrush}"/>
                                            </Canvas>
                                        </StackPanel>
                                    </Border>

                                    <!-- OS Breakdown -->
                                    <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="{DynamicResource ContainerCornerRadius}"
                                            BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock x:Name="DashLblOsBreakdown" Text="OS BREAKDOWN" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                            <Grid Margin="0,0,0,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="WIN 11" Foreground="{DynamicResource LabelBrush}" FontSize="9" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" x:Name="DashOsWin11Bar" Minimum="0" Maximum="100" Value="0"
                                                             Height="4" Margin="8,0" Style="{StaticResource FlatBar}"
                                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrackBrush}"/>
                                                <TextBlock Grid.Column="2" x:Name="DashWin11" Text="--" Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="WIN 10" Foreground="{DynamicResource LabelBrush}" FontSize="9" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" x:Name="DashOsWin10Bar" Minimum="0" Maximum="100" Value="0"
                                                             Height="4" Margin="8,0" Style="{StaticResource FlatBar}"
                                                             Foreground="#60A0FF" Background="{DynamicResource ProgressTrackBrush}"/>
                                                <TextBlock Grid.Column="2" x:Name="DashWin10" Text="--" Foreground="#60A0FF"
                                                           FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="OTHER" Foreground="{DynamicResource LabelBrush}" FontSize="9" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" x:Name="DashOsOtherBar" Minimum="0" Maximum="100" Value="0"
                                                             Height="4" Margin="8,0" Style="{StaticResource FlatBar}"
                                                             Foreground="#7080A0" Background="{DynamicResource ProgressTrackBrush}"/>
                                                <TextBlock Grid.Column="2" x:Name="DashOsOther" Text="--" Foreground="#7080A0"
                                                           FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Row 3: mini stat pills -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="110"/><ColumnDefinition MinWidth="110"/><ColumnDefinition MinWidth="110"/><ColumnDefinition MinWidth="110"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="{DynamicResource ContainerCornerRadius}" Margin="0,0,9,0"
                                            Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                <TextBlock Text="&#xE114;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="#F59E0B" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashLblWebcam" Text="WEBCAM" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DashWebcam" Text="0" Foreground="#F59E0B" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="DashSubWebcam" Text="w/ camera" Foreground="{DynamicResource LabelBrush}" FontSize="9" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="{DynamicResource ContainerCornerRadius}" Margin="0,0,9,0"
                                            Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="#EF4444" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashLblAdmin" Text="ADMIN" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DashAdmin" Text="0" Foreground="#EF4444" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="DashSubAdmin" Text="elevated" Foreground="{DynamicResource LabelBrush}" FontSize="9" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="{DynamicResource ContainerCornerRadius}" Margin="0,0,9,0"
                                            Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="#C8991A" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashLblTagged" Text="TAGGED" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DashTagged" Text="0" Foreground="#C8991A" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="DashSubTagged" Text="marked clients" Foreground="{DynamicResource LabelBrush}" FontSize="9" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" CornerRadius="{DynamicResource ContainerCornerRadius}"
                                            Padding="14,12" BorderThickness="1" BorderBrush="{DynamicResource SectionBorderBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                <TextBlock Text="&#xE12B;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="{DynamicResource LabelBrush}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DashLblTopCountry" Text="TOP COUNTRY" Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DashTopCountry" Text="--" Foreground="{DynamicResource ContentTextBrush}" FontSize="16" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="DashSubTopCountry" Text="by connections" Foreground="{DynamicResource LabelBrush}" FontSize="9" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!--  Online -  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" Foreground="#22C55E" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Online"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Margin="8" CornerRadius="{DynamicResource ContainerCornerRadius}"
                            Background="{DynamicResource SectionBgBrush}" BorderThickness="1">
                        <Border.BorderBrush><DynamicResource ResourceKey="SectionBorderBrush"/></Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource LabelBrush}" />
                                    <TextBox Grid.Column="2" x:Name="TxtSearch"
                                             Background="Transparent" Foreground="{DynamicResource ContentTextBrush}"
                                             BorderThickness="0" Padding="0,9"
                                             FontSize="12" CaretBrush="{DynamicResource AccentBrush}" SelectionBrush="{DynamicResource AccentBrush}"
                                             VerticalContentAlignment="Center"
                                             TextChanged="TxtSearch_TextChanged"
                                             KeyDown="TxtSearch_KeyDown">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock x:Name="Placeholder"
                                                               Text="{TemplateBinding Tag}"
                                                               Foreground="{DynamicResource LabelBrush}" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Visibility="Collapsed" IsHitTestVisible="False" />
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Padding="0,9" VerticalAlignment="Center" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <Button Grid.Column="3" x:Name="BtnGridSettings" Content="☰" FontSize="16"
                                            Foreground="{DynamicResource LabelBrush}" Cursor="Hand" Click="BtnGridSettings_Click" ToolTip="Grid Settings &amp; Filters">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" Padding="10,0">
                                                    <TextBlock x:Name="tb" Text="{TemplateBinding Content}" FontSize="16" Foreground="{TemplateBinding Foreground}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Foreground" Value="#4A85F5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <DataGrid Grid.Column="0" x:Name="GridClients"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          HorizontalAlignment="Stretch"
                                          UseLayoutRounding="True"
                                          PreviewKeyDown="GridClients_PreviewKeyDown"
                                          PreviewMouseLeftButtonDown="GridClients_PreviewMouseLeftButtonDown"
                                          MouseRightButtonDown="GridClients_MouseRightButtonDown"
                                          Sorting="GridClients_Sorting"
                                          SelectionChanged="GridClients_SelectionChanged"
                                          Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource ContentTextBrush}"
                                          BorderThickness="0" RowBackground="{DynamicResource InputBgBrush}"
                                          GridLinesVisibility="None" HeadersVisibility="Column"
                                          FontSize="12" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                                          CanUserResizeColumns="True" CanUserReorderColumns="False"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          EnableColumnVirtualization="False"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          MinHeight="300"
                                      CellStyle="{StaticResource SMainDGCell}"
                                      ColumnHeaderStyle="{StaticResource SColHeader}">
                                    <DataGrid.Resources>
                                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBarStyle}"/>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <!-- FLAG + IP (combined first column for quick geo identification) -->
                                        <DataGridTemplateColumn Header="IP" Width="96" MinWidth="60" SortMemberPath="IP">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Grid Width="28" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Border Background="{DynamicResource SectionBgBrush}" CornerRadius="2"
                                                                    BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="0.5">
                                                                <TextBlock Text="?" Foreground="{DynamicResource FlagUnknownBrush}" FontSize="9"
                                                                           FontFamily="Segoe UI" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Image Source="{Binding FlagImage}" Width="28" Height="20" Stretch="Fill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                                                            <Border CornerRadius="2" IsHitTestVisible="False">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                        <GradientStop Color="#48FFFFFF" Offset="0"/>
                                                                        <GradientStop Color="#18FFFFFF" Offset="0.45"/>
                                                                        <GradientStop Color="#00FFFFFF" Offset="0.46"/>
                                                                        <GradientStop Color="#06FFFFFF" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Border BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="0.5" CornerRadius="2" IsHitTestVisible="False"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding IP}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- STATUS: person silhouette icon — Green=active, Yellow=idle, Grey=AFK; orange dot = operator has session open -->
                                        <DataGridTemplateColumn x:Name="ColStatusHdr" Header="STATUS" Width="68" MinWidth="44" CanUserSort="True" SortMemberPath="StatusColor" CanUserResize="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                ToolTip="{Binding StatusTooltip}">
                                                        <Viewbox Width="11" Height="13" VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <Canvas Width="8" Height="10">
                                                                <Path x:Name="PersonIcon"
                                                                      Data="M6,2.5 A2,2 0 1 0 2,2.5 A2,2 0 1 0 6,2.5 Z M0,10 C0,5.5 2,5 4,5 C6,5 8,5.5 8,10 Z"
                                                                      Fill="#22C55E"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <Ellipse x:Name="BusyDot" Width="5" Height="5"
                                                                 Fill="#F97316" Stroke="#0A0A0A" StrokeThickness="0.5"
                                                                 VerticalAlignment="Center" Margin="0,0,3,0"
                                                                 Visibility="Collapsed">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect Color="#F97316" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                        <TextBlock x:Name="StatusTxt" Text="{Binding StatusText}" FontSize="10"
                                                                   Foreground="#22C55E" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Yellow">
                                                            <Setter TargetName="PersonIcon" Property="Fill"       Value="#F59E0B"/>
                                                            <Setter TargetName="StatusTxt"  Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Grey">
                                                            <Setter TargetName="PersonIcon" Property="Fill"       Value="#6B7280"/>
                                                            <Setter TargetName="StatusTxt"  Property="Foreground" Value="#6B7280"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOperatorBusy}" Value="True">
                                                            <Setter TargetName="BusyDot" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="COUNTRY"  Binding="{Binding CountryDisplay}"                      Width="68" MinWidth="40" MaxWidth="200"/>
                                        <DataGridTextColumn Header="USER"     Binding="{Binding Username}"                            Width="Auto" MinWidth="80" MaxWidth="220"/>
                                        <DataGridTextColumn Header="OS"       Binding="{Binding OS}"                                  Width="66" MinWidth="40" MaxWidth="200"/>
                                        <DataGridTextColumn Header="MACHINE"  Binding="{Binding MachineName}"                         Width="70" MinWidth="40" MaxWidth="200"/>
                                        <DataGridTextColumn Header="PRIV"     Binding="{Binding Privilege}"                           Width="86"  MinWidth="66" MaxWidth="140" FontSize="11"/>
                                        <DataGridTextColumn Header="ID"       Binding="{Binding Id}"                                  Width="56"  MinWidth="36" MaxWidth="160" FontFamily="Consolas" FontSize="11"/>
                                        <!-- CAM: shows camera icon when webcam detected -->
                                        <DataGridTemplateColumn x:Name="ColCamHdr" Header="CAM" Width="64" MinWidth="50" MaxWidth="90" SortMemberPath="CameraIcon">
                                            <DataGridTemplateColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"/>
                                            </DataGridTemplateColumn.CellStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <dx:DXImage x:Name="CamYesIcon"
                                                                    Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Check.svg'}"
                                                                    Width="14" Height="14" Visibility="Collapsed"/>
                                                        <dx:DXImage x:Name="CamNoIcon"
                                                                    Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Remove.svg'}"
                                                                    Width="14" Height="14" Visibility="Collapsed" Opacity="0.45"/>
                                                        <TextBlock x:Name="CamDash" Text="—" FontSize="11"
                                                                   Foreground="{DynamicResource LabelBrush}" Opacity="0.4"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding CameraStatus}" Value="Yes">
                                                            <Setter TargetName="CamYesIcon" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="CamDash"    Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CameraStatus}" Value="No">
                                                            <Setter TargetName="CamNoIcon"  Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="CamDash"    Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="CPU"      Binding="{Binding CpuDisplay}"                          Width="86"  MinWidth="44" MaxWidth="220" FontSize="11"/>
                                        <DataGridTextColumn x:Name="ColLoadHdr" Header="LOAD" Width="Auto" MinWidth="64" MaxWidth="140" Binding="{Binding Payload}" FontFamily="Consolas" FontSize="11"/>
                                        <DataGridTextColumn Header="AV"       Binding="{Binding Antivirus}"                           Width="68"  MinWidth="40" MaxWidth="180" FontSize="11"/>
                                        <DataGridTextColumn Header="RAM"      Binding="{Binding RamDisplay}"                          Width="54"  MinWidth="36" MaxWidth="110" FontFamily="Consolas" FontSize="11"/>
                                        <DataGridTextColumn Header="GPU"      Binding="{Binding GpuDisplay}"                          Width="86"  MinWidth="44" MaxWidth="220" FontSize="11"/>
                                        <DataGridTemplateColumn Header="PING" Width="Auto" MinWidth="48" MaxWidth="100" SortMemberPath="PingMs">
                                            <DataGridTemplateColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"/>
                                            </DataGridTemplateColumn.CellStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PingDisplay}" Foreground="{Binding PingBrush}"
                                                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="WINDOW"   Binding="{Binding ActiveWindow}"                        Width="82"  MinWidth="44" MaxWidth="280"/>
                                        <DataGridTextColumn Header="1ST SEEN" Binding="{Binding FirstSeen, StringFormat=yyyy-MM-dd}"  Width="68"  MinWidth="44" FontFamily="Consolas" FontSize="11"/>
                                        <DataGridTemplateColumn Header="TAG" Width="*" MinWidth="60" SortMemberPath="Tag" CanUserResize="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock x:Name="EmptyTag" Text="" Foreground="Transparent" FontSize="10" Margin="2,0"/>
                                                        <Border x:Name="TagBadge" CornerRadius="3" Padding="6,2"
                                                                Background="#15F59E0B" BorderBrush="#C0F59E0B" BorderThickness="1"
                                                                HorizontalAlignment="Left" Margin="2,0" Visibility="Collapsed">
                                                            <StackPanel Orientation="Horizontal">
                                                                <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Price.svg'}" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Tag}" Foreground="#D4A843"
                                                                           FontSize="10" FontWeight="SemiBold" FontFamily="Segoe UI"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasTag}" Value="True">
                                                            <Setter TargetName="TagBadge" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <!-- Administration -->
                                            <MenuItem x:Name="MenuGrpAdmin" Header="Administration">
                                                <MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Security_Key.svg'}" Width="14" Height="14"/></MenuItem.Icon>
                                                <MenuItem x:Name="MenuItemRemoteShell"    Header="Remote Shell"       Click="RemoteShell_Click">    <MenuItem.Icon><Image Source="pack://application:,,,/shell.png" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/></MenuItem.Icon></MenuItem>
                                                <MenuItem x:Name="MenuItemFileManager"    Header="File Manager"       Click="FileManager_Click">    <MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_FolderOpen.svg'}"          Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                                                <MenuItem x:Name="MenuItemProcessMgr"     Header="Process Manager"    Click="ProcessManager_Click"> <MenuItem.Icon><Image Source="pack://application:,,,/processmanager.png" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/></MenuItem.Icon></MenuItem>
                                                <MenuItem x:Name="MenuItemStartupMgr"     Header="Startup Manager"    Click="StartupManager_Click"> <MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Clock.svg'}"          Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                                                <MenuItem x:Name="MenuItemTcpConn"        Header="TCP Connections"    Click="TcpManager_Click">     <MenuItem.Icon><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Electronics_Router.svg'}"    Width="14" Height="14"/></MenuItem.Icon></MenuItem>
