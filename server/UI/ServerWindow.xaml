                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="VS2017Blue">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#2B3566" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="VS" Foreground="#007ACC" FontSize="8" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="VS 2013 Blue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="VS2017Dark">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#1E1E1E" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="VS" Foreground="#007ACC" FontSize="8" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="VS 2013 Dark" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="VS2017Light">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#F5F5F5"
                                                        BorderBrush="#C8C8C8" BorderThickness="1"
                                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="VS" Foreground="#007ACC" FontSize="8" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="VS 2013 Light" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>

                                        <!-- Previous Office -->
                                        <ComboBoxItem Style="{StaticResource ThemeGroupHeader}">Previous Office</ComboBoxItem>

                                        <ComboBoxItem Tag="Office2010Blue">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#1B5B99" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2010 Blue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2010Black">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#3A3A3A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2010 Black" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2010Silver">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#DFE0E4"
                                                        BorderBrush="#A8ADB8" BorderThickness="1"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2010 Silver" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>

                                        <!-- Office 2019 -->
                                        <ComboBoxItem Style="{StaticResource ThemeGroupHeader}">Office 2019</ComboBoxItem>

                                        <ComboBoxItem Tag="Office2019Colorful">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#2B579A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2019 Colorful" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2019Black">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#1D1D1D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2019 Black" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2019White">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FFFFFF"
                                                        BorderBrush="#2B579A" BorderThickness="1.5"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2019 White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2019DarkGray">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#2D2D2D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2019 Dark" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>

                                        <!-- Office 2016 -->
                                        <ComboBoxItem Style="{StaticResource ThemeGroupHeader}">Office 2016</ComboBoxItem>

                                        <ComboBoxItem Tag="Office2016Colorful">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#2B6CB0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2016 Colorful" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2016DarkGraySE">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#2F2F2F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2016 Dark" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2016Black">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#1A1A1A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2016 Black" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>

                                        <!-- Office 2013 -->
                                        <ComboBoxItem Style="{StaticResource ThemeGroupHeader}">Office 2013</ComboBoxItem>

                                        <ComboBoxItem Tag="Office2013">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#FFFFFF"
                                                        BorderBrush="#2972BF" BorderThickness="1.5"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2013 White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2013DarkGray">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#414141" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Office 2013 Dark Gray" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>

                                        <!-- Default (DevExpress) -->
                                        <ComboBoxItem Style="{StaticResource ThemeGroupHeader}">Default</ComboBoxItem>

                                        <ComboBoxItem Tag="DXStyle">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#3E6FA8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="DX" Foreground="#FFFFFF" FontSize="8" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="DevExpress Style" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="MetropolisDark">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#1C2030" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="DX" Foreground="#5588D8" FontSize="8" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="DevExpress Dark Style" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Office2019HighContrast">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="3" Background="#000000"
                                                        BorderBrush="#FFFFFF" BorderThickness="1.5"
                                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="HC" Foreground="#FFFF00" FontSize="7" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="High Contrast" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>

                                        <!-- Thematic -->
                                        <ComboBoxItem Style="{StaticResource ThemeGroupHeader}">Thematic</ComboBoxItem>

                                        <ComboBoxItem Tag="Seven">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="/windows7.png" Width="20" Height="20"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="Seven Classic" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ComboBoxItem>

                                    </ComboBox>
                                    <!-- Custom theme picker: ToggleButton trigger + dropdown popup -->
                                    <Grid Margin="0,0,0,4" HorizontalAlignment="Left" Width="280">
                                        <ToggleButton x:Name="ThemePickerToggle"
                                                      Height="30" Cursor="Hand"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Center">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="tBd"
                                                            Background="{DynamicResource InputBgBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1" CornerRadius="4">
                                                        <ContentPresenter Margin="8,0,6,0"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tBd" Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="tBd" Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Mini two-tone theme icon -->
                                                <Border Grid.Column="0"
                                                        Width="28" Height="20" CornerRadius="3"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle x:Name="ThemeIconBg"  Fill="#0C0D18"/>
                                                        <Rectangle x:Name="ThemeIconBar" Fill="#111222"
                                                                   Height="6" VerticalAlignment="Top"/>
                                                        <Image x:Name="ThemeIconImage"
                                                               Stretch="Uniform" Visibility="Collapsed"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <ContentControl x:Name="ThemeIconHost"
                                                                        Visibility="Collapsed"
                                                                        Width="28" Height="20"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="ThemeCurrentName" Grid.Column="1"
                                                           Text="Sero Dark"
                                                           Foreground="{DynamicResource ContentTextBrush}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                                <!-- Chevron -->
                                                <Path Grid.Column="2" Data="M0,0 L5,4 L10,0"
                                                      Stroke="#606880" StrokeThickness="1.5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                            </Grid>
                                        </ToggleButton>
                                        <Popup x:Name="ThemePickerPopup"
                                               PlacementTarget="{Binding ElementName=ThemePickerToggle}"
                                               Placement="Bottom" AllowsTransparency="True"
                                               StaysOpen="False" Width="280"
                                               IsOpen="{Binding IsChecked, ElementName=ThemePickerToggle, Mode=TwoWay}"
                                               Opened="ThemePickerPopup_Opened">
                                            <Border Background="{DynamicResource InputBgBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Margin="0,2,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="20"
                                                                      ShadowDepth="6" Opacity="0.6"/>
                                                </Border.Effect>
                                                <DockPanel>
                                                    <!-- Search bar -->
                                                    <Border DockPanel.Dock="Top" Padding="6,5"
                                                            BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Viewbox Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center" Margin="4,0,6,0">
                                                                <Canvas Width="16" Height="16">
                                                                    <Ellipse Width="10" Height="10" Canvas.Left="0.5" Canvas.Top="0.5"
                                                                             Stroke="{DynamicResource LabelBrush}" StrokeThickness="2" Fill="Transparent"/>
                                                                    <Line X1="8.5" Y1="8.5" X2="13.5" Y2="13.5"
                                                                          Stroke="{DynamicResource LabelBrush}" StrokeThickness="2"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBox x:Name="ThemeSearchBox" Grid.Column="1"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     Foreground="{DynamicResource ContentTextBrush}"
                                                                     CaretBrush="{DynamicResource AccentBrush}"
                                                                     FontSize="12" Height="22"
                                                                     VerticalContentAlignment="Center"
                                                                     TextChanged="ThemeSearchBox_TextChanged"/>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Theme list -->
                                                    <ScrollViewer MaxHeight="340"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel x:Name="ThemeItemsPanel"
                                                                    Margin="4,2,4,4"/>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <!-- Accent color palette (hidden for fixed-accent themes like SevenClassic) -->
                                    <StackPanel x:Name="AccentSection" Margin="0,8,0,0">
                                        <TextBlock x:Name="LblSettAccent" Text="ACCENT COLOR" Style="{StaticResource SLabel}" Margin="0,0,0,4"/>
                                        <WrapPanel x:Name="AccentPalettePanel" Margin="0,0,0,8"/>
                                        <Button x:Name="BtnResetAccent" Content="Reset to theme default" Height="24" Padding="10,0"
                                                Style="{StaticResource SBtn}" FontSize="10" HorizontalAlignment="Left" Margin="0,0,0,12"
                                                Click="BtnResetAccent_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="LblSettLanguage" Text="LANGUAGE" Style="{StaticResource SLabel}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="SettingsLanguage"
                                              Style="{StaticResource SCombo}"
                                              Width="200" HorizontalAlignment="Left"
                                              SelectionChanged="SettingsLanguage_Changed"
                                              Margin="0,0,0,20">
                                        <ComboBoxItem Content="English"    Tag="en" IsSelected="True"/>
                                        <ComboBoxItem Content="Fran&#x00E7;ais"   Tag="fr"/>
                                        <ComboBoxItem Content="Espa&#x00F1;ol"    Tag="es"/>
                                        <ComboBoxItem Content="Deutsch"    Tag="de"/>
                                        <ComboBoxItem Content="Portugu&#x00EA;s"  Tag="pt"/>
                                        <ComboBoxItem Content="Italiano"   Tag="it"/>
                                        <ComboBoxItem Content="&#x0420;&#x0443;&#x0441;&#x0441;&#x043A;&#x0438;&#x0439;"    Tag="ru"/>
                                        <ComboBoxItem Content="&#x4E2D;&#x6587;"        Tag="zh"/>
                                        <ComboBoxItem Content="&#x0627;&#x0644;&#x0639;&#x0631;&#x0628;&#x064A;&#x0629;"    Tag="ar"/>
                                        <ComboBoxItem Content="T&#x00FC;rk&#x00E7;e"     Tag="tr"/>
                                    </ComboBox>

                                    <TextBlock x:Name="LblSettAppearance" Text="APPEARANCE" Style="{StaticResource SLabel}" />
                                    <CheckBox x:Name="SettingsHideLogo" Visibility="Collapsed"
                                              Checked="SettingsHideLogo_Changed" Unchecked="SettingsHideLogo_Changed" />
                                    <CheckBox x:Name="SettingsShowSeconds" Visibility="Collapsed"
                                              Checked="SettingsShowSeconds_Changed" Unchecked="SettingsShowSeconds_Changed" />
                                    <CheckBox x:Name="SettingsBlockCapture" Content="Block screen recording (window hidden from OBS / screenshots / RDP)" Style="{StaticResource SChk}" Margin="0,0,0,24"
                                              Checked="SettingsBlockCapture_Changed" Unchecked="SettingsBlockCapture_Changed" />

                                    <TextBlock x:Name="LblSettPortChecker" Text="PORT CHECKER" Style="{StaticResource SLabel}" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBox x:Name="SettingsCheckIP"   Style="{StaticResource STxt}" Width="160" Text="127.0.0.1" Margin="0,0,0,4"/>
                                        <TextBlock Text=":" Foreground="{DynamicResource LabelBrush}" FontSize="16" VerticalAlignment="Center" Margin="8,0,8,4" />
                                        <TextBox x:Name="SettingsCheckPort" Style="{StaticResource STxt}" Width="64" Text="7777" Margin="0,0,0,4"/>
                                        <Button x:Name="BtnCheckPort" Content="CHECK" Height="32" MinWidth="72" Margin="10,0,0,4" Padding="10,0" Style="{StaticResource SGreenBtn}" Click="CheckPort_Click" />
                                        <Button x:Name="BtnGetIp"    Content="GET IP" Height="32" MinWidth="72" Margin="8,0,0,4"  Padding="10,0" Style="{StaticResource SBtn}"      Click="GetMyIP_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtPortResult" Text="" Foreground="{DynamicResource LabelBrush}" FontSize="12" Margin="0,4,0,24" />
                                </StackPanel>

                                <!-- Right Column: Sound Preferences -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblSettSoundPrefs" Text="SOUND PREFERENCES" Style="{StaticResource SLabel}" />
                                    <Border Background="{DynamicResource SectionBgBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,24">
                                        <StackPanel>
                                            <!-- Header Row -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="82" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="LblSndColEvent"   Grid.Column="0" Text="EVENT / ACTION" Foreground="{DynamicResource LabelBrush}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="LblSndColStatus"  Grid.Column="1" Text="STATUS" Foreground="{DynamicResource LabelBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                                                <TextBlock x:Name="LblSndColPreview" Grid.Column="2" Text="PREVIEW" Foreground="{DynamicResource LabelBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource InputBorderBrush}" Margin="0,0,0,8"/>

                                            <!-- Sound Rows -->
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="82" />
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="True">
                                                    <dx:DXImage DockPanel.Dock="Left" Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Opportunity.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="SndLbl_Intro" Text="Intro / Logo Animation" Foreground="{DynamicResource ContentTextBrush}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <CheckBox Grid.Column="1" x:Name="SndChk_Intro" Style="{StaticResource SChk}" VerticalAlignment="Center" Margin="8,0,0,0" Checked="SoundSetting_Changed" Unchecked="SoundSetting_Changed">
                                                    <TextBlock x:Name="SndChkLbl_Intro" Text="Enabled" Foreground="{DynamicResource ContentTextBrush}" FontSize="11"/>
                                                </CheckBox>
                                                <Button Grid.Column="2" x:Name="SndPly_Intro" Style="{StaticResource SBtn}" Height="22" FontSize="10" Click="PreviewSound_Click" Tag="Intro.wav" HorizontalAlignment="Right" Padding="6,0">
                                                    <StackPanel Orientation="Horizontal"><dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Icon Builder/Actions_Arrow1Right.svg'}" Width="11" Height="11" Margin="0,0,4,0"/><TextBlock x:Name="SndPlyLbl_Intro" Text="Play"/></StackPanel>
                                                </Button>
                                            </Grid>

                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="82" />
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Grid.Column="0" VerticalAlignment="Center" LastChildFill="True">
                                                    <dx:DXImage DockPanel.Dock="Left" Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Scheduler.svg'}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="SndLbl_Startup" Text="Server Startup" Foreground="{DynamicResource ContentTextBrush}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                                                </DockPanel>
                                                <CheckBox Grid.Column="1" x:Name="SndChk_Startup" Style="{StaticResource SChk}" VerticalAlignment="Center" Margin="8,0,0,0" Checked="SoundSetting_Changed" Unchecked="SoundSetting_Changed">
                                                    <TextBlock x:Name="SndChkLbl_Startup" Text="Enabled" Foreground="{DynamicResource ContentTextBrush}" FontSize="11"/>
