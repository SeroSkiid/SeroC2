                                            <TextBlock x:Name="AboutFeatRemoteShell" Text="Remote Shell" Foreground="{DynamicResource ContentTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutFeatRemoteDesktop" Text="Remote Desktop" Foreground="{DynamicResource ContentTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,14,5">
                                            <TextBlock Text="&#xE114;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutFeatRemoteWebcam" Text="Remote Webcam" Foreground="{DynamicResource ContentTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutFeatFileExec" Text="File Execution" Foreground="{DynamicResource ContentTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,14,5">
                                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutFeatUpdateClient" Text="Update Client" Foreground="{DynamicResource ContentTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutFeatUninstall" Text="Uninstall Client" Foreground="{DynamicResource ContentTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,14,5">
                                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutFeatUacElevation" Text="UAC Elevation" Foreground="{DynamicResource ContentTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       Foreground="{DynamicResource AccentBrush}" FontSize="11"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutFeatAutoTask" Text="AutoTask" Foreground="{DynamicResource ContentTextBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,14,5">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       Foreground="{DynamicResource LabelBrush}" FontSize="11"
                                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AboutFeatAndMore" Text="And more?" Foreground="{DynamicResource LabelBrush}"
                                                       FontSize="11" FontStyle="Italic" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>

                                <!-- Contact -->
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="C  O  N  T  A  C  T" HorizontalAlignment="Center"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,12"/>

                                    <!-- Telegram button -->
                                    <Button HorizontalAlignment="Center" Cursor="Hand"
                                            Click="TelegramLink_Click"
                                            Background="Transparent" BorderThickness="0" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="TgBorder" CornerRadius="12" Padding="24,13"
                                                        BorderThickness="1"
                                                        Background="{DynamicResource TitleBgBrush}">
                                                    <Border.BorderBrush>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#702CA5E0" Offset="0"/>
                                                            <GradientStop Color="#704A85F5" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.BorderBrush>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="/telegram.png" Width="22" Height="22"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="@serotohnine"
                                                                   Foreground="{DynamicResource NavSelTextBrush}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TgBorder" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="TgBorder" Property="Opacity" Value="0.50"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Website button -->
                                    <Button HorizontalAlignment="Center" Cursor="Hand" Margin="0,8,0,0"
                                            Click="WebsiteLink_Click"
                                            Background="Transparent" BorderThickness="0" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="WebBorder" CornerRadius="12" Padding="24,13"
                                                        BorderThickness="1"
                                                        Background="{DynamicResource TitleBgBrush}">
                                                    <Border.BorderBrush>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#704A85F5" Offset="0"/>
                                                            <GradientStop Color="#707C5CE8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.BorderBrush>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE774;"
                                                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                   FontSize="18" VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"
                                                                   Foreground="{DynamicResource NavSelTextBrush}"/>
                                                        <TextBlock Text="serorat.zip"
                                                                   Foreground="{DynamicResource NavSelTextBrush}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="WebBorder" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="WebBorder" Property="Opacity" Value="0.50"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>
            </Grid>

        </Grid>
    </Border>
</dx:ThemedWindow>
