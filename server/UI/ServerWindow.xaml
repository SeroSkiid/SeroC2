                                                    BorderThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#4A85F5" Offset="0"/>
                                                        <GradientStop Color="#C44BFF" Offset="0.5"/>
                                                        <GradientStop Color="#5B9BD5" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <ImageBrush ImageSource="/photo.png" Stretch="UniformToFill"
                                                                AlignmentX="Center" AlignmentY="Top"
                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border.Background>
                                                <Border.Clip><EllipseGeometry Center="55,55" RadiusX="55" RadiusY="55"/></Border.Clip>
                                            </Border>
                                        </Grid>

