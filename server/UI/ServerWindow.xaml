                                            <TextBlock FontSize="12" FontStyle="Italic" Foreground="{DynamicResource ContentTextBrush}"
                                                       Margin="0,0,0,5" TextWrapping="Wrap">
                                                Powerful lightweight polymorphic x64 RAT
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,10">
                                                by Serotonine · Cool French Developer
