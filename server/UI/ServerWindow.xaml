<dx:ThemedWindow x:Class="SeroServer.UI.ServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="SeroRAT"
        Icon="/serofondtransparent.ico"
        Width="1240" Height="740"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowGlow="False"
        UseLayoutRounding="True"
        RenderOptions.ClearTypeHint="Enabled"
        Closing="ServerWindow_Closing">

    <dx:ThemedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Row-level defaults — overridden per-theme by ApplyTheme code -->
        <Thickness x:Key="RowBorderThicknessKey">0</Thickness>

        <!-- Flat progress bar used in dashboard OS breakdown -->
        <Style x:Key="FlatBar" TargetType="ProgressBar">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush"     Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}" />
            <Style.Triggers>
                <!-- Tagged rows: amber tint — evaluated first so selection overrides it -->
                <DataTrigger Binding="{Binding HasTag}" Value="True">
                    <Setter Property="Background" Value="#20F59E0B"/>
                </DataTrigger>
                <!-- Hover is handled at cell level only (no double-layer with row+cell) -->
                <!-- Selection: accent gradient fills the entire row behind transparent cells -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Named cell style — set directly on DataGrid.CellStyle (FrameworkElement context finds
             Window.Resources). Uses Border right-side border as separator: simpler and more reliable
             than a Grid+Rectangle which can disappear at certain sub-pixel window widths. -->
        <Style x:Key="SMainDGCell" TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="Padding"               Value="0"/>
            <Setter Property="FocusVisualStyle"      Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellBd"
                                Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="0,0,1,0"
                                Padding="10,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Last column: remove right border to prevent phantom strip during resize -->
                            <Trigger Property="Tag" Value="NoSep">
                                <Setter TargetName="CellBd" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            <!-- Tagged rows get amber tint -->
                            <DataTrigger Binding="{Binding HasTag}" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="#20F59E0B"/>
                            </DataTrigger>
                            <!-- Hover -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowHoverBgBrush}"/>
                            </DataTrigger>
                            <!-- Selection — keep separator visible against selection background -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                <Setter TargetName="CellBd" Property="Background"   Value="{DynamicResource RowSelBgBrush}"/>
                                <Setter TargetName="CellBd" Property="BorderBrush"  Value="{DynamicResource RowSelBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Implicit fallback — wins over App.xaml SDGCell for all DataGridCells in this window -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource SMainDGCell}"/>

        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}" />
            <Setter Property="Padding"         Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="Transparent">
                            <!-- Item row -->
                            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Margin="1,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="Transparent"/>
                                    <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1" Fill="{DynamicResource InputBorderBrush}" VerticalAlignment="Stretch"/>
                                    <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="0,6,0,6"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      Margin="4,7,4,7" VerticalAlignment="Center"/>
                                    <Path x:Name="Arrow" Grid.Column="2"
                                          Data="M 0 0 L 5 4 L 0 8 Z"
                                          Fill="{DynamicResource LabelBrush}"
                                          Width="5" Height="8" Stretch="Fill"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- Sub-menu popup (only rendered when item has children) -->
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right" HorizontalOffset="0" VerticalOffset="-5"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" MinWidth="168">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000"/>
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamically swappable accent brush + color ? changed by ApplyTheme() -->
        <Color x:Key="AccentColor">#4A85F5</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#4A85F5"/>

        <!-- Non-selectable group header inside the theme ComboBox -->
        <Style x:Key="ThemeGroupHeader" TargetType="ComboBoxItem">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable"        Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{DynamicResource SectionBgBrush}" Padding="8,5,8,4">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource LabelBrush}" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton style used for theme selectors in Settings -->
        <Style x:Key="SRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ring" Width="16" Height="16"
                                    Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1.5" CornerRadius="8"
                                    VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Ellipse x:Name="dot" Width="6" Height="6"
                                         Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot"  Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ring" Property="Background"  Value="{DynamicResource NavSelBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav RadioButton style -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="MouseMove"  Handler="NavBtn_MouseMove"/>
            <EventSetter Event="MouseLeave" Handler="NavBtn_MouseLeave"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Height="30">
                            <Border x:Name="Bg" Background="Transparent"/>
                            <Border x:Name="SpotGlow" IsHitTestVisible="False" Opacity="0" ClipToBounds="True">
                                <Border.Background>
                                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.52" RadiusY="0.88">
                                        <GradientStop Color="#5EFFFFFF" Offset="0"/>
                                        <GradientStop Color="#18FFFFFF" Offset="0.52"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <ContentPresenter x:Name="Icon"
                                              Content="{TemplateBinding Tag}"
                                              Width="16"
                                              Height="16"
                                              Margin="0,0,9,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource NavIconBrush}"/>
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                           FontSize="12" Foreground="{DynamicResource NavTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg"       Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
                                <Setter TargetName="SpotGlow" Property="Opacity"    Value="1"/>
                                <Setter TargetName="Label"    Property="Foreground" Value="{DynamicResource NavHoverTextBrush}"/>
                                <Setter TargetName="Icon"     Property="TextElement.Foreground" Value="{DynamicResource NavHoverIconBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg"       Property="Background" Value="{DynamicResource NavSelBgBrush}"/>
                                <Setter TargetName="SpotGlow" Property="Opacity"    Value="0.22"/>
                                <Setter TargetName="Label"    Property="Foreground" Value="{DynamicResource NavSelTextBrush}"/>
                                <Setter TargetName="Icon"     Property="TextElement.Foreground" Value="{DynamicResource NavSelIconBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked"   Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SpotGlow" Property="Opacity" Value="1"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global themed scrollbar ? no arrows, thin track, accent thumb ? unique per theme via AccentBrush -->
        <!-- Modern thin scrollbar (used by all themes except Seven Classic) -->
        <Style x:Key="ModernScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- Vertical template (default) -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="8" SnapsToDevicePixels="True">
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4" Opacity="0.6"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,0,0,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" IsTabStop="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="40">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="4" Margin="2,0" Opacity="0.55"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.80"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" IsTabStop="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Horizontal orientation override -->
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Height"    Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Height="8" SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4" Opacity="0.6"/>
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,0,4,0">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                          Opacity="0" IsTabStop="False" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinWidth="40">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="Bd" Background="{DynamicResource AccentBrush}"
                                                                CornerRadius="4" Margin="0,2" Opacity="0.55"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.80"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="1.0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                          Opacity="0" IsTabStop="False" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Neutral thin scrollbar — same shape as Modern but uses grey instead of AccentBrush.
             Used for WXI / Basic / WindowsXP so the thumb doesn't look like a coloured border. -->
        <Style x:Key="NeutralScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="8" SnapsToDevicePixels="True">
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4" Opacity="0.4"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,0,0,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" IsTabStop="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="40">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="Bd" Background="#9EB0C4"
                                                        CornerRadius="4" Margin="2,0" Opacity="0.55"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.80"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" IsTabStop="False" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Height"    Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Height="8" SnapsToDevicePixels="True">
                                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4" Opacity="0.4"/>
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,0,4,0">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                                          Opacity="0" IsTabStop="False" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinWidth="40">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="Bd" Background="#9EB0C4"
                                                                CornerRadius="4" Margin="0,2" Opacity="0.55"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.80"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="1.0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                                          Opacity="0" IsTabStop="False" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Classic Windows 7 scrollbar (Seven Classic theme) ? wide with arrows and grip marks -->
        <Style x:Key="ClassicScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="17"/>
            <Setter Property="MinWidth" Value="17"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="17" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="17"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="17"/>
                            </Grid.RowDefinitions>
                            <!-- Track background: hatch-like warm gray -->
                            <Border Grid.Row="1" BorderThickness="1,0,0,0" BorderBrush="#B0AFAA">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F5F3EE" Offset="0"/>
                                        <GradientStop Color="#E0DDD8" Offset="0.5"/>
                                        <GradientStop Color="#F0EDE8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- Track -->
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" IsTabStop="False" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Margin="0,2,0,2">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBd" BorderThickness="1" BorderBrush="#9B9998" Margin="0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FAFAF8" Offset="0"/>
                                                            <GradientStop Color="#E8E5DF" Offset="0.5"/>
                                                            <GradientStop Color="#D8D4CC" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <!-- 3 horizontal grip lines centered on thumb -->
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
                                                          IsHitTestVisible="False" Width="9">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="1"/>
                                                            <RowDefinition Height="3"/>
                                                            <RowDefinition Height="1"/>
                                                            <RowDefinition Height="3"/>
                                                            <RowDefinition Height="1"/>
                                                        </Grid.RowDefinitions>
                                                        <Rectangle Grid.Row="0" Height="1" Fill="#888880"/>
                                                        <Rectangle Grid.Row="2" Height="1" Fill="#888880"/>
                                                        <Rectangle Grid.Row="4" Height="1" Fill="#888880"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#EEF5FF" Offset="0"/>
                                                                    <GradientStop Color="#D0E5FF" Offset="0.5"/>
                                                                    <GradientStop Color="#C4D9F8" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="ThumbBd" Property="BorderBrush" Value="#6B9FD4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#C8DCF8" Offset="0"/>
                                                                    <GradientStop Color="#A8C8F0" Offset="0.5"/>
                                                                    <GradientStop Color="#98BCE8" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
