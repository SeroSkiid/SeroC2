                                            <TextBlock FontSize="26" FontWeight="Bold" Margin="0,0,0,2">
                                                <Run Text="Sero">
                                                    <Run.Foreground>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#4A85F5" Offset="0"/>
                                                            <GradientStop Color="#5B9BD5" Offset="1"/>
                                                        </LinearGradientBrush>
