<dx:ThemedWindow x:Class="SeroServer.UI.ClientLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Client Logs"
        Width="600" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

        <DockPanel LastChildFill="True">

            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBgBrush}" BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <dx:DXImage Source="{dx:DXImageExtension 'SvgImages/Business Objects/BO_Document.svg'}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitle" Text="" FontSize="11" FontWeight="Light"
                                   Foreground="{DynamicResource FieldLabelBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Log Entries �" RichTextBox for colour-coded + selectable log text -->
            <Border Background="{DynamicResource SectionBgBrush}" Margin="10,8,10,10"
                    CornerRadius="8" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                <RichTextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             IsReadOnly="True" IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="10" SelectionBrush="{DynamicResource FieldLabelBrush}" CaretBrush="Transparent">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="LineHeight" Value="16"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Border>
        </DockPanel>
</dx:ThemedWindow>
