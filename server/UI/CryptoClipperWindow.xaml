<dx:ThemedWindow x:Class="SeroServer.UI.CryptoClipperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        Title="Crypto Clipper"
        Width="680" Height="620" MinWidth="540" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowGlow="False">

    <Window.Resources>
        <Style x:Key="AddrBox" TargetType="TextBox">
            <Setter Property="Background"              Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground"              Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="6,4"/>
            <Setter Property="FontFamily"              Value="Consolas"/>
            <Setter Property="FontSize"                Value="10"/>
            <Setter Property="Height"                  Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CoinLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="Width"       Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

        <DockPanel LastChildFill="True">

            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource TitleBgBrush}" BorderBrush="{DynamicResource TitleBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/crypto/btc.png" Width="14" Height="14" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitle" Text="" FontSize="11" Foreground="{DynamicResource TitleTextBrush}" FontFamily="Consolas"/>
                        <Border x:Name="BadgeActive" Margin="10,0,0,0" CornerRadius="3"
                                Background="#0A1E10" BorderBrush="#1A5E28" BorderThickness="1"
                                Padding="6,2" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,5,0">
                                    <Ellipse.Effect><DropShadowEffect Color="#22C55E" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="ACTIVE" Foreground="#22C55E" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Stats" Width="60" Height="26" Margin="0,0,4,0"
                                Style="{StaticResource SBtn}" FontSize="10" Click="BtnStats_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource TitleBgBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="Configure replacement addresses and enable"
                               Foreground="{DynamicResource LabelBrush}" FontSize="11" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="14,0"/>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,12">

                    <!-- Enable toggle -->
                    <Border Background="{DynamicResource TitleBgBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkEnabled" Content="Enable Crypto Clipper"
                                          Foreground="{DynamicResource ContentTextBrush}" FontSize="12" FontWeight="SemiBold"
                                          VerticalAlignment="Center" Checked="ChkEnabled_Changed" Unchecked="ChkEnabled_Changed"/>
                                <TextBlock Text="Monitors clipboard for crypto addresses and silently replaces them"
                                           Foreground="{DynamicResource LabelBrush}" FontSize="10" FontFamily="Segoe UI Variable Text, Segoe UI"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                            <Button Content="Apply" Width="64" Height="26" HorizontalAlignment="Right"
                                    Style="{StaticResource SGreenBtn}" FontSize="10" Click="BtnApply_Click"/>
                        </Grid>
                    </Border>

                    <!-- Address config -->
                    <Border Background="{DynamicResource TitleBgBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="REPLACEMENT ADDRESSES" Foreground="{DynamicResource TitleTextBrush}" FontSize="9"
                                       FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="BTC" Style="{StaticResource CoinLabel}" Grid.Column="0"/>
                                <TextBox x:Name="AddrBTC" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="Bitcoin ? P2PKH (1...), P2SH (3...), Bech32 (bc1...)"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="ETH/BNB" Style="{StaticResource CoinLabel}" Grid.Column="0" Width="54"/>
                                <TextBox x:Name="AddrETH" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="Ethereum / BNB Smart Chain ? 0x..."/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="LTC" Style="{StaticResource CoinLabel}" Grid.Column="0"/>
                                <TextBox x:Name="AddrLTC" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="Litecoin ? L..., M..., or 3..."/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="TRX" Style="{StaticResource CoinLabel}" Grid.Column="0"/>
                                <TextBox x:Name="AddrTRX" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="TRON ? T..."/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="SOL" Style="{StaticResource CoinLabel}" Grid.Column="0"/>
                                <TextBox x:Name="AddrSOL" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="Solana ? base58, 32-44 chars"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="XMR" Style="{StaticResource CoinLabel}" Grid.Column="0"/>
                                <TextBox x:Name="AddrXMR" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="Monero ? 4..., 95 chars"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="XRP" Style="{StaticResource CoinLabel}" Grid.Column="0"/>
                                <TextBox x:Name="AddrXRP" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="Ripple ? r..."/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="DASH" Style="{StaticResource CoinLabel}" Grid.Column="0"/>
                                <TextBox x:Name="AddrDASH" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="Dash ? X..."/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="BCH" Style="{StaticResource CoinLabel}" Grid.Column="0"/>
                                <TextBox x:Name="AddrBCH" Grid.Column="1" Style="{StaticResource AddrBox}"
                                         ToolTip="Bitcoin Cash ? bitcoincash:q... or p..."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Detection log -->
                    <Border Background="{DynamicResource TitleBgBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="DETECTION LOG" Foreground="{DynamicResource TitleTextBrush}" FontSize="9"
                                           FontWeight="SemiBold" FontFamily="Segoe UI Variable Text, Segoe UI"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtCount" Text="0 replacements" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Content="Clear log" Width="64" Height="22"
                                            Style="{StaticResource SBtn}" FontSize="9" Click="BtnClearLog_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4" Height="120">
                                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Background="Transparent">
                                    <TextBox x:Name="TxtLog"
                                             Background="Transparent" Foreground="{DynamicResource ContentTextBrush}"
                                             FontFamily="Consolas" FontSize="10"
                                             BorderThickness="0" Padding="8,6"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          VerticalScrollBarVisibility="Disabled"
                                                                          Background="Transparent"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
</dx:ThemedWindow>
