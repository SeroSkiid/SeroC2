<Application x:Class="SeroServer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="UI/ServerWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ── Palette ─────────────────────────────────────────── -->
        <Color x:Key="BgColor">#0C0D18</Color>
        <Color x:Key="SurfaceColor">#111222</Color>
        <Color x:Key="CardColor">#171828</Color>
        <Color x:Key="BorderColor">#1E2038</Color>
        <Color x:Key="BlueColor">#4A85F5</Color>
        <Color x:Key="VioletColor">#7C5CE8</Color>
        <Color x:Key="CyanColor">#4A85F5</Color>
        <Color x:Key="GreenColor">#22C55E</Color>
        <Color x:Key="RedColor">#EF4444</Color>
        <Color x:Key="YellowColor">#F59E0B</Color>
        <Color x:Key="PurpleColor">#7C5CE8</Color>
        <Color x:Key="TextColor">#DDE0F0</Color>
        <Color x:Key="DimColor">#606880</Color>

        <SolidColorBrush x:Key="BgBrush"      Color="#0C0D18" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#111222" />
        <SolidColorBrush x:Key="CardBrush"    Color="#171828" />
        <SolidColorBrush x:Key="BorderBrush"  Color="#1E2038" />
        <SolidColorBrush x:Key="BlueBrush"    Color="#4A85F5" />
        <SolidColorBrush x:Key="VioletBrush"  Color="#7C5CE8" />
        <SolidColorBrush x:Key="CyanBrush"    Color="#4A85F5" />
        <SolidColorBrush x:Key="GreenBrush"   Color="#22C55E" />
        <SolidColorBrush x:Key="RedBrush"     Color="#EF4444" />
        <SolidColorBrush x:Key="YellowBrush"  Color="#F59E0B" />
        <SolidColorBrush x:Key="PurpleBrush"  Color="#7C5CE8" />
        <SolidColorBrush x:Key="TextBrush"    Color="#DDE0F0" />
        <SolidColorBrush x:Key="DimBrush"     Color="#606880" />

        <!-- DynamicResource theming tokens — overridden globally by ApplyTheme() via Application.Current.Resources -->
        <!-- Window / layout brushes -->
        <SolidColorBrush x:Key="TitleTextBrush"        Color="#4A85F5"/>
        <SolidColorBrush x:Key="WindowBgBrush"        Color="#0C0D18"/>
        <SolidColorBrush x:Key="TitleBgBrush"         Color="#111222"/>
        <SolidColorBrush x:Key="TitleBorderBrush"     Color="#191B30"/>
        <SolidColorBrush x:Key="SectionBgBrush"       Color="#0D0E1A"/>
        <SolidColorBrush x:Key="SectionBorderBrush"   Color="#1E2038"/>
        <SolidColorBrush x:Key="ActivityBgBrush"      Color="#0C0D18"/>
        <!-- DataGrid alternating row — overridden per theme by ApplyTheme() -->
        <SolidColorBrush x:Key="AlternatingRowBgBrush" Color="#0D1A2540"/>
        <!-- DataGrid row selection — distinct from nav/sidebar selection; overridden by ApplyTheme() -->
        <SolidColorBrush x:Key="RowSelBgBrush"    Color="#4A85F5"/>
        <SolidColorBrush x:Key="RowSelTextBrush"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RowSelBorderBrush" Color="#6A85F5"/>
        <SolidColorBrush x:Key="RowHoverBgBrush"  Color="#2A4A85F5"/>
        <!-- DataGrid row selection accent bar — cyan that adapts per theme by ApplyTheme() -->
        <SolidColorBrush x:Key="SelBarBrush"      Color="#00D4FF"/>
        <!-- Navigation hover/selection — shared with feature window DataGrid rows -->
        <SolidColorBrush x:Key="NavHoverBgBrush"      Color="#111830"/>
        <SolidColorBrush x:Key="NavSelBgBrush"        Color="#0E1A3A"/>
        <SolidColorBrush x:Key="NavSelTextBrush"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavHoverTextBrush"    Color="#8090B8"/>
        <SolidColorBrush x:Key="NavSelIconBrush"      Color="#4A85F5"/>
        <SolidColorBrush x:Key="NavIconBrush"         Color="#5070A0"/>
        <SolidColorBrush x:Key="NavTextBrush"         Color="#7080A0"/>
        <!-- Dashboard card brushes -->
        <SolidColorBrush x:Key="CardBgBrush"          Color="#0A0D1A"/>
        <SolidColorBrush x:Key="ChartBgBrush"         Color="#07080F"/>
        <SolidColorBrush x:Key="ProgressTrackBrush"   Color="#13172A"/>
        <SolidColorBrush x:Key="WindowOutlineBrush"   Color="Transparent"/>
        <Thickness x:Key="WindowOutlineThickness">0</Thickness>
        <!-- Input / form controls -->
        <SolidColorBrush x:Key="InputBgBrush"         Color="#0D0E1A"/>
        <SolidColorBrush x:Key="InputBorderBrush"     Color="#1E2038"/>
        <!-- Text -->
        <SolidColorBrush x:Key="ContentTextBrush"     Color="#DDE0F0"/>
        <SolidColorBrush x:Key="LabelBrush"           Color="#A0AAC8"/>
        <SolidColorBrush x:Key="FieldLabelBrush"      Color="#8090B4"/>
        <!-- Unknown flag placeholder — bright/visible in both themes -->
        <SolidColorBrush x:Key="FlagUnknownBrush"     Color="#9CA3AF"/>
        <!-- Column header — distinct from row content; overridden per theme by ApplyTheme() -->
        <SolidColorBrush x:Key="ColHeaderBgBrush"     Color="#131426"/>
        <SolidColorBrush x:Key="ColHeaderFgBrush"     Color="#8090B8"/>
        <SolidColorBrush x:Key="ColHeaderBorderBrush" Color="#606888"/>
        <!-- Hover bg — auto-computed by ApplyTheme: dark→+20 RGB brighter, light→-18 RGB darker -->
        <SolidColorBrush x:Key="ColHeaderHoverBrush"  Color="#21223A"/>
        <!-- Accent color scalar — overridden by ApplyTheme(); default guards SlimSlider in feature windows
             that open before the first ApplyTheme() call completes. -->
        <Color x:Key="AccentColor">#5B6ACF</Color>
        <!-- Buttons -->
        <SolidColorBrush x:Key="BtnBgBrush"           Color="#141526"/>
        <SolidColorBrush x:Key="BtnBorderBrush"       Color="#1E2038"/>
        <SolidColorBrush x:Key="BtnHoverBgBrush"      Color="#1A1B2E"/>
        <SolidColorBrush x:Key="BtnHoverBorderBrush"  Color="#2A2D50"/>
        <SolidColorBrush x:Key="BtnPressedBgBrush"    Color="#0E0F1A"/>
        <!-- Button foreground — dark for light themes, light for dark themes -->
        <SolidColorBrush x:Key="BtnFgBrush"           Color="#DDE0F0"/>
        <!-- Primary action button bg — adapts per theme via ApplyTheme(); default = accent blue -->
        <SolidColorBrush x:Key="BtnPrimaryBgBrush"    Color="#4A85F5"/>
        <!-- Sidebar panel — overridden per theme by ApplyTheme() -->
        <SolidColorBrush x:Key="SidebarBgBrush"       Color="#0B0C17"/>
        <SolidColorBrush x:Key="SidebarBorderBrush"   Color="#1C1E30"/>

        <!-- Text selection — high contrast for visibility on hover/select -->
        <SolidColorBrush x:Key="SelectionBgBrush"     Color="#6A85F5"/>
        <SolidColorBrush x:Key="SelectionFgBrush"     Color="#FFFFFF"/>

        <!-- Fallback AccentBrush — overridden by each theme; prevents DynamicResource miss at startup -->
        <SolidColorBrush x:Key="AccentBrush"          Color="#5B6ACF"/>

        <!-- Primary gradient — uses AccentBrush so it adapts per theme -->
        <SolidColorBrush x:Key="PrimaryGradient"      Color="#4A85F5"/>
        <LinearGradientBrush x:Key="AccentBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A85F5" Offset="0" />
            <GradientStop Color="#7C5CE8" Offset="1" />
        </LinearGradientBrush>

        <!-- ── Secondary button ───────────────────────────────── -->
        <Style x:Key="SBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BtnBgBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource BtnFgBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BtnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="14,7" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource BtnHoverBgBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BtnHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnPressedBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary button (accent colour, adapts per theme) ─── -->
        <Style x:Key="SGreenBtn" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource BtnPrimaryBgBrush}" />
            <Setter Property="Foreground"      Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="14,7" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#55FFFFFF" Offset="0"/>
                                    <GradientStop Color="#10FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Danger button ──────────────────────────────────── -->
        <Style x:Key="SRedBtn" TargetType="Button" BasedOn="{StaticResource SBtn}">
            <Setter Property="Background"  Value="{DynamicResource BtnBgBrush}" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Foreground"  Value="#EF4444" />
        </Style>

        <!-- ── TextBox ────────────────────────────────────────── -->
        <Style x:Key="STxt" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,6" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="CaretBrush"      Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush"  Value="{DynamicResource SelectionBgBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── CheckBox ───────────────────────────────────────── -->
        <Style x:Key="SChk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}" />
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Margin"     Value="0,0,0,6" />
            <Setter Property="Cursor"     Value="Hand" />
        </Style>

        <!-- ── Settings CheckBox ──────────────────────────────── -->
        <Style x:Key="SettingsChk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}" />
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Margin"     Value="0,0,0,8" />
            <Setter Property="Cursor"     Value="Hand" />
        </Style>

        <!-- ── Section label ──────────────────────────────────── -->
        <Style x:Key="SLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,0,0,8" />
        </Style>

        <!-- ── Field label ────────────────────────────────────── -->
        <Style x:Key="SFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FieldLabelBrush}" />
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Margin"     Value="0,0,0,4" />
        </Style>

        <!-- ── ListBox ────────────────────────────────────────── -->
        <Style x:Key="SListBox" TargetType="ListBox">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="4" />
            <Setter Property="FontSize"        Value="12" />
        </Style>

        <!-- ── ComboBox ───────────────────────────────────────── -->
        <Style x:Key="SCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,4" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <ControlTemplate.Resources>
                            <!-- Prevent WPF's GrayTextBrush from overriding text when disabled -->
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Grid>
                            <!-- button + border -->
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- selected-item label (non-editable mode) -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                    <!-- editable text input (IsEditable="True" mode) -->
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{TemplateBinding Foreground}"
                                             Padding="{TemplateBinding Padding}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Focusable="True"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Visibility="Hidden"
                                             BorderThickness="0"/>
                                    <!-- chevron -->
                                    <Path Grid.Column="1"
                                          Data="M2,5 L6,9 L10,5"
                                          Stroke="#6070A0" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                    <!-- transparent hit-test overlay that opens the dropdown.
                                         A custom template is required so WPF never renders the
                                         system ToggleButton background (which goes white/gray
                                         on disabled state and hides the dark text behind it). -->
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                  Background="Transparent" BorderThickness="0"
                                                  Focusable="False" IsTabStop="False"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <!-- dropdown popup -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="None">
                                <Border Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000" BlurRadius="10"
                                                          ShadowDepth="2" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="380" CanContentScroll="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite"          Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
                        <Setter Property="Padding"    Value="8,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent"
                                            CornerRadius="4" Margin="3,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource NavHoverTextBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSelBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource NavSelTextBrush}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsHighlighted" Value="True"/>
                                                <Condition Property="IsSelected"    Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSelBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource NavSelTextBrush}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ScrollBar ───────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"    Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Rectangle Fill="{DynamicResource InputBgBrush}" RadiusX="3" RadiusY="3" Opacity="0.5"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,3">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" Background="{DynamicResource AccentBrush}" CornerRadius="3" Margin="1,0" Opacity="0.55"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="tb" Property="Opacity" Value="1.0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto"/>
                    <Setter Property="MinWidth"  Value="0"/>
                    <Setter Property="Height"    Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Rectangle Fill="{DynamicResource InputBgBrush}" RadiusX="5" RadiusY="5" Opacity="0.5"/>
                                    <Track x:Name="PART_Track" Margin="4,0">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Background="Transparent" BorderThickness="0" Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinWidth="30">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="tb" Background="{DynamicResource AccentBrush}" CornerRadius="4" Margin="0,2" Opacity="0.55"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="tb" Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="tb" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Background="Transparent" BorderThickness="0" Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── TbarChk / SlimSlider ─────────────────────────── -->
        <Style x:Key="TbarChk" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>

        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Cursor="Hand" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" CornerRadius="1.5" Cursor="Hand">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                            <GradientStop Color="#7C5CE8" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="5" ShadowDepth="0" Opacity="0.5"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="{DynamicResource SectionBorderBrush}" CornerRadius="1.5" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ToolTip ──────────────────────────────────────── -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="MaxWidth"        Value="420"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="9,6" MaxWidth="420">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ContextMenu ─────────────────────────────────── -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource InputBgBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
                            </Border.Effect>
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── MenuItem ────────────────────────────────────── -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="Transparent">
                            <!-- Item row -->
                            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Margin="1,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="Transparent"/>
                                    <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1"
                                               Fill="{DynamicResource InputBorderBrush}" VerticalAlignment="Stretch"/>
                                    <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="0,5,0,5"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      Margin="4,7,4,7" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" FontSize="13"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource LabelBrush}" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- Sub-menu popup (only rendered when item has children) -->
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right" HorizontalOffset="0" VerticalOffset="-5"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" MinWidth="168">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.75" Color="#000"/>
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Separator ───────────────────────────────────── -->
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{DynamicResource InputBorderBrush}" Margin="8,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid row — custom template kills default VSM selection highlight ── -->
        <Style TargetType="DataGridRow">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle"      Value="{x:Null}"/>
            <Setter Property="Background"            Value="Transparent"/>
            <Setter Property="BorderBrush"           Value="Transparent"/>
            <Setter Property="BorderThickness"       Value="0"/>
            <Setter Property="MinHeight"             Value="30"/>
            <Setter Property="Foreground"            Value="{DynamicResource ContentTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <DataGridRowHeader Grid.Column="0"
                                    SelectiveScrollingGrid.SelectiveScrollingOrientation="None"/>
                                <DataGridCellsPresenter Grid.Column="1"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </SelectiveScrollingGrid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBgBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"  Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── DataGridRowHeader: 3-px left accent bar, no layout impact ── -->
        <Style TargetType="DataGridRowHeader">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width"   Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border x:Name="Bar"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0"/>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                <Setter TargetName="Bar" Property="Opacity" Value="0.35"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SDGCell" TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid>
                            <!-- Left accent bar — shows on selection, adapts per theme -->
                            <Border x:Name="SelBar" Width="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource SelBarBrush}" Visibility="Collapsed"/>
                            <!-- Main cell -->
                            <Border x:Name="CellBd"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="10,4">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover: uniform across all columns via parent row's IsMouseOver -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowHoverBgBrush}"/>
                            </DataTrigger>
                            <!-- Selection overrides hover; bind to row since SelectionUnit=FullRow keeps cell.IsSelected False -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="{DynamicResource RowSelBgBrush}"/>
                                <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource RowSelTextBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Implicit DataGridCell style — re-applied by ApplyTheme() after DX theme changes -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource SDGCell}"/>

        <!-- ── DataGrid column header with sort arrow + resize grippers ── -->
        <Style x:Key="SColHeader" TargetType="DataGridColumnHeader">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background"      Value="{DynamicResource ColHeaderBgBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource ColHeaderFgBrush}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource ColHeaderBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid UseLayoutRounding="True">
                            <!-- Base background -->
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"/>
                            <!-- Hover overlay — smooth fade via EventTrigger storyboard, never overrides base bg resource -->
                            <Border x:Name="HoverOverlay"
                                    Background="{DynamicResource ColHeaderHoverBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <!-- Content row: label + sort chevron -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="10,9"/>
                                <Path x:Name="SortArrow" Grid.Column="1"
                                      Visibility="Collapsed"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      VerticalAlignment="Center"
                                      Margin="4,0,10,0"/>
                            </Grid>
                            <!-- Accent bottom bar — hidden by default; slides in on sort/hover -->
                            <Rectangle x:Name="AccentBar" VerticalAlignment="Bottom" Height="2"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                            <!-- Separator — 1px tick inset 5px top/bottom; brightens to 0.9 on hover -->
                            <Rectangle x:Name="Separator"
                                       HorizontalAlignment="Right" Width="1" Margin="0,5,1,5"
                                       Fill="{DynamicResource ColHeaderBorderBrush}"
                                       Opacity="0.45"
                                       SnapsToDevicePixels="True"
                                       RenderOptions.EdgeMode="Aliased"
                                       IsHitTestVisible="False"/>
                            <!-- Resize grippers — transparent hit area only -->
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6"
                                   Cursor="SizeWE" Background="Transparent">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6"
                                   Cursor="SizeWE" Background="Transparent">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Sort indicators: show chevron + accent bar at 0.8 opacity -->
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data"       Value="M0,5 L4,1 L8,5"/>
                                <Setter TargetName="AccentBar" Property="Opacity"    Value="0.80"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data"       Value="M0,1 L4,5 L8,1"/>
                                <Setter TargetName="AccentBar" Property="Opacity"    Value="0.80"/>
                            </Trigger>
                            <!-- Hover: fade overlay bg in (120ms), bring accent bar to full, brighten separator -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Separator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.9" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <!-- Leave: fade out (100ms); FillBehavior=Stop releases hold so sorted-column    -->
                            <!-- opacity (0.80) and Separator local value (0.45) re-assert naturally.      -->
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="AccentBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="Separator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.45" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
                            </Trigger>
                            <!-- TAG column: right gripper inactive (star must never become pixel) -->
                            <Trigger Property="CanUserResize" Value="False">
                                <Setter TargetName="PART_RightHeaderGripper" Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="PART_RightHeaderGripper" Property="IsHitTestVisible" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global DataGrid: single-click select + rubber band + 3-px row-header accent bar -->
        <Style TargetType="DataGrid">
            <Setter Property="RowHeaderWidth"    Value="3"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGrid_SelectOnClick"/>
            <EventSetter Event="Loaded"                    Handler="DataGrid_EnableRubberBand"/>
        </Style>

        <!-- Shared icon button style used by BtnMenu in feature windows (HVNC, Remote Desktop, Webcam, …) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Height"          Value="26"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="{DynamicResource WindowBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource SectionBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource FieldLabelBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource NavHoverBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ContentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSelBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
